---
// Terminal.astro — a quiet, paper-toned terminal: the prompt types `felix`, then the profile prints line by line
// (portrait on the left, facts on the right). Without JS or under prefers-reduced-motion everything is visible at
// once. Values may use tokens such as {commits} (rounded, from github.json) or {lingxian.users} (metrics.json).
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';
import type { GithubData } from '../lib/github';
import github from '../data/github.json';
import { fill, siteTokens } from '../lib/tokens';

interface Props { title: string; user: string; command: string; lines: { k: string; v: string }[]; repo: string }
const { title, user, command, lines, repo } = Astro.props;
const tokens = siteTokens(github as GithubData, repo);
const rows = lines.map((l) => ({ k: l.k, v: fill(l.v, tokens) }));
---
<div class="term" data-terminal role="figure" aria-label={title}>
  <div class="bar" aria-hidden="true"><span class="title">{title}</span></div>
  <div class="body">
    <p class="line prompt"><span class="dollar">$</span> <span class="cmd" data-cmd data-text={command}>{command}</span><span class="caret" data-caret aria-hidden="true"></span></p>
    <div class="fetch" data-output>
      <figure class="art">
        <Image src={photo} alt="" width={320} height={400} fit="cover" format="webp" quality={84} loading="eager" />
        <figcaption>photo.jpg</figcaption>
      </figure>
      <dl class="facts">
        <div class="head"><span class="user">{user}</span></div>
        {rows.map((row) => (
          <div class="row">
            <dt>{row.k}</dt>
            <dd>{row.v.includes('@') ? <>{row.v.split('@')[0]}<wbr />@{row.v.split('@').slice(1).join('@')}</> : row.v}</dd>
          </div>
        ))}
      </dl>
    </div>
    <p class="line prompt end" data-end><span class="dollar">$</span> <span class="caret blink" aria-hidden="true"></span></p>
  </div>
</div>
<style>
  .term {
    --t-bg: color-mix(in srgb, var(--fg) 4%, var(--bg));
    --t-bar: color-mix(in srgb, var(--fg) 7%, var(--bg));
    --t-line: color-mix(in srgb, var(--fg) 12%, var(--bg));
    color: var(--fg); background: var(--t-bg);
    border: 1px solid var(--t-line); border-radius: 14px; overflow: hidden;
    box-shadow: 0 24px 48px -28px color-mix(in srgb, var(--fg) 35%, transparent);
  }
  .bar { padding: 0.55rem 1.1rem; background: var(--t-bar); border-bottom: 1px solid var(--t-line); }
  .title { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.06em; color: var(--fg-muted); }
  .body { padding: 1.1rem 1.25rem 1rem; }
  .line { margin: 0; font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.6; white-space: nowrap; }
  .dollar { color: var(--fg-muted); }
  .cmd { color: var(--fg); }
  .caret { display: inline-block; width: 0.55em; height: 1.05em; background: var(--fg); vertical-align: -0.18em; margin-left: 2px; }
  .caret.blink { animation: blink 1s steps(2, start) infinite; }
  @keyframes blink { to { visibility: hidden; } }

  .fetch { display: grid; grid-template-columns: 128px 1fr; gap: 1.4rem; margin: 1rem 0 1.1rem; align-items: start; }
  .art { margin: 0; }
  .art :global(img) {
    display: block; width: 128px; height: 160px; object-fit: cover; object-position: top; border-radius: 8px;
    box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--fg) 55%, transparent), 0 0 0 1px var(--t-line);
  }
  .art figcaption { font-family: var(--font-mono); font-size: 0.66rem; color: var(--fg-muted); margin-top: 0.5rem; letter-spacing: 0.04em; }
  .facts { margin: 0; min-width: 0; }
  .head { font-family: var(--font-mono); font-size: 0.8rem; color: var(--fg); padding-bottom: 0.45rem; margin-bottom: 0.6rem; border-bottom: 1px solid var(--t-line); }
  .row { display: grid; grid-template-columns: 5.6rem 1fr; gap: 0.7rem; padding: 0.22rem 0; }
  :root:lang(zh) .row { grid-template-columns: 3.2rem 1fr; }
  dt { margin: 0; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-muted); padding-top: 0.2em; }
  :root:lang(zh) dt { text-transform: none; letter-spacing: 0.12em; font-size: 0.74rem; }
  dd { margin: 0; font-family: var(--font-sans); font-size: 0.88rem; line-height: 1.45; color: var(--fg); overflow-wrap: break-word; }
  .end { margin-top: 0.2rem; }

  /* typing: hide until the script reveals; no JS or reduced motion → shown at once */
  html.js .term[data-animate] .cmd { visibility: hidden; }
  html.js .term[data-animate] .row, html.js .term[data-animate] .head, html.js .term[data-animate] .art, html.js .term[data-animate] .end { opacity: 0; }
  html.js .term[data-animate] [data-shown] { opacity: 1; transition: opacity 0.14s ease; }
  html.js .term[data-animate] .caret[data-caret] { display: inline-block; }
  .caret[data-caret] { display: none; }

  /* Narrow: portrait above the facts so the value column keeps a readable width */
  @media (max-width: 560px) {
    .body { padding: 1rem 1rem 0.9rem; }
    .fetch { grid-template-columns: 1fr; gap: 0.9rem; }
    .art { display: flex; align-items: flex-end; gap: 0.6rem; }
    .art :global(img) { width: 88px; height: 110px; }
    .art figcaption { margin: 0 0 0.2rem; }
    .row { grid-template-columns: 5.4rem 1fr; gap: 0.6rem; }
    :root:lang(zh) .row { grid-template-columns: 3rem 1fr; }
    dd { font-size: 0.85rem; }
  }
</style>
<script>
  const term = document.querySelector<HTMLElement>('[data-terminal]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (term && !reduced) {
    term.setAttribute('data-animate', '');
    const cmd = term.querySelector<HTMLElement>('[data-cmd]');
    const caret = term.querySelector<HTMLElement>('[data-caret]');
    const parts = [
      ...Array.from(term.querySelectorAll<HTMLElement>('.art, .head')),
      ...Array.from(term.querySelectorAll<HTMLElement>('.row')),
      ...Array.from(term.querySelectorAll<HTMLElement>('[data-end]')),
    ];
    const text = cmd?.dataset.text ?? '';
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      await sleep(500);
      if (cmd) {
        cmd.style.visibility = 'visible';
        for (let i = 1; i <= text.length; i++) { cmd.textContent = text.slice(0, i); await sleep(90); }
        await sleep(250);
      }
      if (caret) caret.style.display = 'none';
      for (const el of parts) { el.setAttribute('data-shown', ''); await sleep(70); }
      term.setAttribute('data-done', '');
    })();
  }
</script>
