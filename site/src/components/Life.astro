---
// Life.astro — "Beyond work": hobby cards that filter a photo wall. Photos live in src/assets/life/<hobby>/.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Locale } from '../i18n';
import { loadLife } from '../lib/life';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const life = loadLife(locale);

const files = import.meta.glob<ImageMetadata>('../assets/life/**/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' });
const resolve = (file: string): ImageMetadata => {
  const meta = files[`../assets/life/${file}`];
  if (!meta) throw new Error(`life: photo "${file}" not found under src/assets/life/`);
  return meta;
};
const photos = await Promise.all(
  life.photos.map(async (p) => ({ ...p, meta: resolve(p.file), large: await getImage({ src: resolve(p.file), width: 1800, format: 'webp', quality: 80 }) })),
);
const counts = Object.fromEntries(life.hobbies.map((h) => [h.id, photos.filter((p) => p.hobby === h.id).length]));

// line icons, 24px, stroke-based so they inherit the text colour
const icons: Record<string, string> = {
  guqin: '<path d="M3 6h18M3 9h18M3 12h18M3 15h18M3 18h18" /><path d="M7 4v16M17 4v16" opacity=".5" />',
  photo: '<rect x="3" y="7" width="18" height="13" rx="2" /><circle cx="12" cy="13.5" r="3.5" /><path d="M8 7l1.5-3h5L16 7" />',
  cooking: '<path d="M4 10h16l-1.5 9a2 2 0 0 1-2 1.8h-9a2 2 0 0 1-2-1.8L4 10z" /><path d="M2 10h20M8 6c0-2 2-2 2-4M12 6c0-2 2-2 2-4" />',
  games: '<rect x="2" y="7" width="20" height="11" rx="5" /><path d="M7 11v3M5.5 12.5h3M15.5 11.5h.01M18 13.5h.01" />',
  swimming: '<path d="M2 17c2 0 2-1.5 4-1.5s2 1.5 4 1.5 2-1.5 4-1.5 2 1.5 4 1.5 2-1.5 4-1.5" /><circle cx="16" cy="7" r="2" /><path d="M4 13l5-5 4 3" />',
};
---
<section id="life" class="wrap section">
  <div class="section-head reveal">
    <h2>{tr('sections.life')}</h2>
    <p class="sub">{life.intro}</p>
  </div>

  <ul class="hobbies" data-hobbies>
    {life.hobbies.map((h) => (
      <li class="reveal">
        <button type="button" class="hobby" data-hobby={h.id} aria-pressed="false" disabled={counts[h.id] === 0}>
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[h.id] ?? ''} />
          <span class="title">{h.title}{counts[h.id] > 0 && <span class="count">{counts[h.id]}</span>}</span>
          <span class="blurb">{h.blurb}</span>
        </button>
      </li>
    ))}
  </ul>

  {photos.length > 0 && (
    <ul class="wall" data-wall>
      {photos.map((p, i) => (
        <li data-hobby={p.hobby} class="reveal">
          <figure>
            <button type="button" data-lightbox-src={p.large.src} data-lightbox-alt={p.caption} aria-label={`${tr('a11y.openImage')} ${i + 1}: ${p.caption}`}>
              <Image src={p.meta} alt={p.caption} width={720} format="webp" quality={80} loading="lazy" />
            </button>
            <figcaption>{p.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  )}
</section>
<style>
  .hobbies { list-style: none; margin: 0 0 2.5rem; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 720px) { .hobbies { grid-template-columns: repeat(5, 1fr); } }
  .hobby {
    all: unset; box-sizing: border-box; display: flex; flex-direction: column; gap: 0.5rem; width: 100%; height: 100%;
    padding: 1.1rem 1rem 1.2rem; border-radius: var(--radius); background: var(--card); cursor: pointer;
    transition: background-color 0.16s ease, box-shadow 0.16s ease;
  }
  .hobby:hover { background: var(--card-hover); }
  .hobby:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .hobby[aria-pressed='true'] { box-shadow: inset 0 0 0 1.5px var(--fg); }
  .hobby:disabled { cursor: default; }
  .hobby:disabled:hover { background: var(--card); }
  .icon { width: 24px; height: 24px; color: var(--fg-muted); }
  .title { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 500; color: var(--fg); display: flex; align-items: baseline; gap: 0.4rem; }
  .count { font-family: var(--font-mono); font-size: 0.65rem; color: var(--fg-muted); }
  .blurb { font-size: 0.8rem; line-height: 1.45; color: var(--fg-muted); }

  .wall { list-style: none; margin: 0; padding: 0; columns: 1; column-gap: 1.25rem; }
  @media (min-width: 560px) { .wall { columns: 2; } }
  @media (min-width: 900px) { .wall { columns: 3; } }
  .wall li { break-inside: avoid; margin-bottom: 1.25rem; }
  .wall li[hidden] { display: none; }
  figure { margin: 0; }
  .wall button { all: unset; display: block; width: 100%; cursor: zoom-in; border-radius: 10px; overflow: hidden; border: 1px solid var(--rule); background: var(--card); }
  .wall button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .wall img { display: block; width: 100%; height: auto; }
  figcaption { font-size: 0.8rem; color: var(--fg-muted); margin-top: 0.45rem; line-height: 1.45; }
</style>
<script>
  // Hobby cards filter the wall; pressing the active card again shows everything.
  const cards = document.querySelectorAll<HTMLButtonElement>('[data-hobbies] .hobby');
  const items = document.querySelectorAll<HTMLElement>('[data-wall] > li');
  const apply = (active: string | null) => {
    cards.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.hobby === active)));
    items.forEach((li) => { li.hidden = active !== null && li.dataset.hobby !== active; });
  };
  cards.forEach((c) =>
    c.addEventListener('click', () => apply(c.getAttribute('aria-pressed') === 'true' ? null : (c.dataset.hobby ?? null))),
  );
</script>
