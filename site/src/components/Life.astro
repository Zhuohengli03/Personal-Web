---
// Life.astro — "Beyond work": five hobbies as rows. The label sits on the left; a hobby with photos gets a slowly
// scrolling strip on the right (paused on hover, static and hand-scrollable under reduced motion). Photos live in
// src/assets/life/<hobby>/ and are listed in src/data/life.*.json; a hobby without photos is just its label.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, localePath, type Locale } from '../i18n';
import { loadLife } from '../lib/life';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const life = loadLife(locale);

const files = import.meta.glob<ImageMetadata>('../assets/life/**/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' });
const resolve = (file: string): ImageMetadata => {
  const meta = files[`../assets/life/${file}`];
  if (!meta) throw new Error(`life: photo "${file}" not found under src/assets/life/`);
  return meta;
};
const STRIP_H = 220;
const photos = await Promise.all(
  life.photos.map(async (p, i) => {
    const meta = resolve(p.file);
    return { ...p, i, meta, w: Math.round((meta.width * STRIP_H) / meta.height), large: await getImage({ src: meta, width: 1800, format: 'webp', quality: 80 }) };
  }),
);
const byHobby = (id: string) => photos.filter((p) => p.hobby === id);
const CARD_H = 220;
const cardImage = (file: string) => { const meta = resolve(file); return { meta, w: Math.round((meta.width * CARD_H) / meta.height) }; };
const SECONDS_PER_PHOTO = 4; // one full loop of the strip takes 4 s per photo

// line icons, 24px, stroke-based so they inherit the text colour
const icons: Record<string, string> = {
  guqin: '<path d="M3 6h18M3 9h18M3 12h18M3 15h18M3 18h18" /><path d="M7 4v16M17 4v16" opacity=".5" />',
  photo: '<rect x="3" y="7" width="18" height="13" rx="2" /><circle cx="12" cy="13.5" r="3.5" /><path d="M8 7l1.5-3h5L16 7" />',
  cooking: '<path d="M4 10h16l-1.5 9a2 2 0 0 1-2 1.8h-9a2 2 0 0 1-2-1.8L4 10z" /><path d="M2 10h20M8 6c0-2 2-2 2-4M12 6c0-2 2-2 2-4" />',
  games: '<rect x="2" y="7" width="20" height="11" rx="5" /><path d="M7 11v3M5.5 12.5h3M15.5 11.5h.01M18 13.5h.01" />',
  swimming: '<path d="M2 17c2 0 2-1.5 4-1.5s2 1.5 4 1.5 2-1.5 4-1.5 2 1.5 4 1.5 2-1.5 4-1.5" /><circle cx="16" cy="7" r="2" /><path d="M4 13l5-5 4 3" />',
  fitness: '<path d="M6 8v8M18 8v8M3 10v4M21 10v4M6 12h12" /><path d="M8 6v12M16 6v12" opacity=".5" />',
  boardgames: '<rect x="3" y="3" width="18" height="18" rx="3" /><circle cx="8" cy="8" r="1.2" /><circle cx="16" cy="8" r="1.2" /><circle cx="12" cy="12" r="1.2" /><circle cx="8" cy="16" r="1.2" /><circle cx="16" cy="16" r="1.2" />',
  gatherings: '<circle cx="8" cy="8" r="3" /><circle cx="16.5" cy="9" r="2.5" /><path d="M2.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5" /><path d="M14 18c.4-2.3 2-3.5 4-3.5s3.5 1.5 3.5 3.5" />',
  badminton: '<path d="M14 10l6-6" /><path d="M9 15a4 4 0 1 0 5.5-5.5A4 4 0 0 0 9 15z" /><path d="M3 21l5-5" /><path d="M11 11l4 4" opacity=".5" />',
  pingpong: '<circle cx="9.5" cy="9.5" r="6" /><path d="M14 14l6 6" /><circle cx="18" cy="6" r="1.8" /><path d="M5 9.5h9M9.5 5v9" opacity=".4" />',
};
---
<section id="life" class="wrap section">
  <div class="section-head reveal">
    <h2>{tr('sections.life')}</h2>
    <p class="sub">{life.intro}</p>
  </div>

  <ol class="rows" data-hobbies>
    {life.hobbies.filter((h) => !h.small).map((h) => {
      const own = byHobby(h.id);
      return (
        <li class:list={['row', 'reveal', { 'has-photos': own.length > 0, 'has-cards': own.length === 0 && (h.cards?.length ?? 0) > 0 }]} data-hobby={h.id}>
          <div class:list={['label', { linked: Boolean(h.page) }]}>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[h.id] ?? ''} />
            <h3 class="title">{h.page ? <a href={localePath(`/life/${h.id}/`, locale)} aria-label={`${h.title} — ${tr('life.more')}`} data-umami-event="hobby-open" data-umami-event-slug={h.id}>{h.title}</a> : h.title}{own.length > 0 && <span class="count">{own.length}</span>}</h3>
            <p class="blurb">{h.blurb}</p>
            {h.link && <a class="link" href={h.link.href} target="_blank" rel="me noopener" data-umami-event="outbound-hobby" data-umami-event-slug={h.id}>{h.link.label} ↗</a>}
          </div>
          {own.length === 0 && h.cards && h.cards.length > 0 && (
            <div class="strip cards" data-strip style={`--loop: ${h.cards.length * SECONDS_PER_PHOTO}s`}>
              <ul class="track">
                {[false, true].map((dup) => h.cards!.map((c) => {
                  const img = c.image ? cardImage(c.image) : null;
                  const body = (
                    <>
                      {img ? <Image src={img.meta} alt={c.title} width={img.w} height={CARD_H} format="webp" quality={80} loading="lazy" /> : <span class="cover-text" aria-hidden="true">{c.title}</span>}
                      <span class="card-title">{c.title}</span>
                      <span class="card-meta">{c.meta}</span>
                    </>
                  );
                  return (
                    <li class:list={['game', { dup }]} aria-hidden={dup ? 'true' : undefined}>
                      {c.href ? <a href={c.href} target="_blank" rel="noopener" tabindex={dup ? -1 : 0} data-umami-event="outbound-hobby" data-umami-event-slug={c.title}>{body}</a> : <div>{body}</div>}
                    </li>
                  );
                }))}
              </ul>
            </div>
          )}
          {own.length > 0 && (
            <div class="strip" data-strip style={`--loop: ${own.length * SECONDS_PER_PHOTO}s`}>
              <ul class="track">
                {[false, true].map((dup) => own.map((p) => (
                  <li class:list={{ dup }} aria-hidden={dup ? 'true' : undefined}>
                    <button type="button" tabindex={dup ? -1 : 0} data-lightbox-src={p.large.src} data-lightbox-alt={p.caption} aria-label={tr('a11y.openImage').replace('{n}', String(p.i + 1)).replace('{alt}', p.caption)}>
                      <Image src={p.meta} alt={p.caption} width={p.w} height={STRIP_H} format="webp" quality={80} loading="lazy" />
                    </button>
                  </li>
                )))}
              </ul>
            </div>
          )}
        </li>
      );
    })}
  </ol>

  {life.hobbies.some((h) => h.small) && (
    <ol class="tiles" data-tiles style={`counter-reset: hobby ${life.hobbies.filter((h) => !h.small).length}`}>
      {life.hobbies.filter((h) => h.small).map((h) => (
        <li class="tile reveal" data-hobby={h.id}>
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[h.id] ?? ''} />
          <h3 class="title">{h.title}</h3>
          <p class="blurb">{h.blurb}</p>
        </li>
      ))}
    </ol>
  )}
</section>
<style>
  .rows { list-style: none; margin: 0; padding: 0; counter-reset: hobby; border-top: 1px solid var(--rule); }
  .row { counter-increment: hobby; display: grid; gap: 1rem 2rem; padding: 1.4rem 0; border-bottom: 1px solid var(--rule); grid-template-columns: 1fr; }
  @media (min-width: 720px) { .row { grid-template-columns: minmax(220px, 1fr) 2.4fr; align-items: center; } .row.has-photos, .row.has-cards { padding: 1.6rem 0; } }
  .label { display: grid; grid-template-columns: 24px 1fr; gap: 0.25rem 0.75rem; align-items: start; }
  .icon { width: 24px; height: 24px; color: var(--fg-muted); grid-row: span 2; margin-top: 0.1rem; }
  .title { margin: 0; font-family: var(--font-sans); font-size: 1rem; font-weight: 500; color: var(--fg); display: flex; align-items: baseline; gap: 0.5rem; }
  .title::before { content: counter(hobby, decimal-leading-zero); font-family: var(--font-mono); font-size: 0.65rem; font-weight: 400; letter-spacing: 0.08em; color: var(--fg-muted); }
  .count { font-family: var(--font-mono); font-size: 0.65rem; color: var(--fg-muted); }
  .title a { color: inherit; text-decoration: none; }
  /* a hobby with its own page: the whole label is the link (the title's link is stretched over it) and shows a
     button-like outline on hover; the outbound link inside stays its own target */
  .label.linked { position: relative; padding: 0.8rem 0.9rem; margin: -0.8rem -0.9rem; border-radius: 10px; cursor: pointer; transition: box-shadow 0.16s ease, background-color 0.16s ease; }
  .label.linked .title a::after { content: ''; position: absolute; inset: 0; border-radius: 10px; }
  .label.linked .link { position: relative; z-index: 1; }
  .label.linked:hover, .label.linked:has(.title a:focus-visible) { box-shadow: inset 0 0 0 1px var(--fg); }
  .label.linked:has(.link:hover) { box-shadow: none; }
  .label.linked .title a:focus-visible { outline: none; }
  .blurb { margin: 0; font-size: 0.85rem; line-height: 1.5; color: var(--fg-muted); max-width: 34ch; }
  .link { grid-column: 2; justify-self: start; margin-top: 0.35rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--fg); }

  /* the small hobbies: one tile each, numbered on from the rows */
  .tiles { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 0.9rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 720px) { .tiles { grid-template-columns: repeat(5, 1fr); } }
  .tile { counter-increment: hobby; display: flex; flex-direction: column; gap: 0.35rem; padding: 1rem 1rem 1.1rem; border-radius: var(--radius); background: var(--card); }
  .tile .icon { margin-bottom: 0.2rem; }
  .tile .blurb { max-width: none; font-size: 0.8rem; }

  /* the strip: a track twice as long as its photos, moved left by half its width on a loop, so the join is seamless */
  .strip { position: relative; overflow: hidden; border-radius: 10px; }
  .strip::before, .strip::after { content: ''; position: absolute; top: 0; bottom: 0; width: 2.5rem; z-index: 1; pointer-events: none; }
  .strip::before { left: 0; background: linear-gradient(90deg, var(--bg), transparent); }
  .strip::after { right: 0; background: linear-gradient(270deg, var(--bg), transparent); }
  .track { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.6rem; width: max-content; animation: life-strip var(--loop, 60s) linear infinite; }
  .strip:hover .track, .strip:focus-within .track { animation-play-state: paused; }
  .track li { flex: none; }
  .track button { all: unset; display: block; cursor: zoom-in; border-radius: 8px; overflow: hidden; background: var(--card); }
  .track button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .track img { display: block; height: 220px; width: auto; }
  @media (max-width: 560px) { .track img { height: 160px; } }
  /* game cards: cover (or the name set large when there is no cover), then name and hours underneath */
  .game > a, .game > div { display: flex; flex-direction: column; gap: 0.3rem; width: max-content; color: inherit; text-decoration: none; }
  .game img { display: block; height: 220px; width: auto; border-radius: 8px; background: var(--card); }
  .cover-text { display: flex; align-items: flex-end; box-sizing: border-box; height: 220px; width: 147px; padding: 0.9rem; border-radius: 8px; background: var(--card); font-family: var(--font-serif); font-size: 1.25rem; line-height: 1.2; color: var(--fg); }
  .card-title { margin-top: 0.2rem; font-family: var(--font-sans); font-size: 0.82rem; color: var(--fg); }
  .card-meta { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.02em; color: var(--fg-muted); }
  .game > a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 8px; }
  @media (max-width: 560px) { .game img, .cover-text { height: 160px; } .cover-text { width: 107px; } }
  @keyframes life-strip { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; width: auto; }
    .track li.dup { display: none; }
    .strip { overflow-x: auto; scroll-snap-type: x mandatory; }
    .track li { scroll-snap-align: start; }
    .strip::before, .strip::after { display: none; }
  }
</style>
