---
import { t, type Locale } from '../i18n';
import type { Profile } from '../lib/profile';
interface Props { item: Profile['education'][number]; locale: Locale }
const { item, locale } = Astro.props;
const tr = t(locale);
---
<article class="card edu reveal">
  <p class="eyebrow">{item.period}{item.gpa && ` · ${tr('labels.gpa')} ${item.gpa}`}</p>
  <h3>{item.school}</h3>
  <p class="muted">{item.degree}</p>
  {item.coursework.length > 0 && (
    <p class="courses"><span class="eyebrow">{tr('labels.coursework')}</span> {item.coursework.join(' · ')}</p>
  )}
  {item.honors.length > 0 && (
    <details>
      <summary>{tr('sections.honors')} · {tr('labels.honorCount').replace('{n}', String(item.honors.length))}</summary>
      <ul>{item.honors.map((h) => <li>{h}</li>)}</ul>
    </details>
  )}
</article>
<style>
  .edu { display: flex; flex-direction: column; gap: 0.5rem; }
  .courses { margin-top: 0.5rem; font-size: 0.9rem; line-height: 1.55; color: var(--fg-muted); }
  .courses .eyebrow { display: block; margin-bottom: 0.2rem; }
  details { margin-top: 0.75rem; font-size: 0.9rem; }
  summary { cursor: pointer; color: var(--accent); }
  ul { margin: 0.6rem 0 0; padding-left: 1.1rem; color: var(--fg-muted); line-height: 1.6; }
</style>
