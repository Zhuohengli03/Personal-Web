---
import { t, type Locale } from '../i18n';
import type { Profile } from '../lib/profile';
interface Props { item: Profile['education'][number]; locale: Locale }
const { item, locale } = Astro.props;
const tr = t(locale);
---
<article class="card edu reveal">
  <p class="eyebrow">{item.period}{item.gpa && ` · GPA ${item.gpa}`}</p>
  <h3>{item.school}</h3>
  <p class="muted">{item.degree}</p>
  {item.honors.length > 0 && (
    <details>
      <summary>{tr('sections.honors')} ({item.honors.length})</summary>
      <ul>{item.honors.map((h) => <li>{h}</li>)}</ul>
    </details>
  )}
</article>
<style>
  .edu { display: flex; flex-direction: column; gap: 0.5rem; }
  details { margin-top: 0.75rem; font-size: 0.9rem; }
  summary { cursor: pointer; color: var(--accent); }
  ul { margin: 0.6rem 0 0; padding-left: 1.1rem; color: var(--fg-muted); line-height: 1.6; }
</style>
