---
import { t, altPath, localePath, type Locale } from '../i18n';
interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const tr = t(locale);
const home = localePath('/', locale);
const alt = altPath(path, locale);
const nav = [
  [tr('nav.work'), `${home}#work`],
  [tr('nav.experience'), `${home}#experience`],
  [tr('nav.life'), `${home}#life`],
  [tr('nav.contact'), `${home}#contact`],
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href={home}>Zhuoheng Li</a>
    <nav aria-label={tr('a11y.primaryNav')}>
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
      <a href={alt} hreflang={locale === 'zh' ? 'en' : 'zh-CN'} data-lang-switch>{tr('nav.switch')}</a>
      <button type="button" id="theme-toggle" aria-label={tr('nav.theme')} title={tr('nav.theme')}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M8 1.5a6.5 6.5 0 0 0 0 13z" fill="currentColor"/></svg>
      </button>
    </nav>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule); }
  .bar { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; }
  .wordmark { font-family: var(--font-serif); font-size: 1.1rem; color: var(--fg); white-space: nowrap; }
  nav { display: flex; align-items: center; gap: 1.25rem; font-size: 0.9rem; white-space: nowrap; }
  nav a { color: var(--fg-muted); }
  nav a:hover { color: var(--fg); text-decoration: none; }
  #theme-toggle { background: none; border: 0; color: var(--fg-muted); cursor: pointer; padding: 4px; display: inline-flex; border-radius: 6px; }
  #theme-toggle:hover { color: var(--fg); background: var(--card); }
  @media (max-width: 560px) {
    /* five links + switch + toggle do not fit beside the wordmark; the name leads the hero anyway */
    .wordmark { display: none; }
    .bar { justify-content: center; }
    nav { gap: 0.8rem; font-size: 0.85rem; }
  }
</style>
<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
    const current = root.getAttribute('data-theme') ?? (systemDark ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch { /* ignore */ }
  });
</script>
