---
import type { CollectionEntry } from 'astro:content';
import { t, localePath, type Locale } from '../i18n';
import { slugOf } from '../lib/pairing';
import { repoActivity } from '../lib/activity';
import type { GithubData } from '../lib/github';
import github from '../data/github.json';
import Waffle from './Waffle.astro';

interface Props { entry: CollectionEntry<'projects'>; locale: Locale }
const { entry, locale } = Astro.props;
const tr = t(locale);
const d = entry.data;
const href = localePath(`/work/${slugOf(entry)}/`, locale);
const activity = d.waffle?.source === 'github' ? repoActivity(github as GithubData, d.waffle.repo, locale) : null;
---
<article class="card work reveal">
  <div class="head">
    <h3><a href={href}>{d.title}</a></h3>
    <span class="badge">{tr(`category.${d.category}`)}</span>
  </div>
  <p class="body">{d.summary}</p>
  {activity && <div class="waffle-wrap"><Waffle cells={activity.cells} cols={activity.cols} label={activity.label} /></div>}
  <dl class="spec-grid">
    <dt>{tr('labels.role')}</dt><dd>{d.role}</dd>
    <dt>{tr('labels.period')}</dt><dd>{d.period}</dd>
    <dt>{tr('labels.stack')}</dt><dd>{d.stack.slice(0, 5).join(' · ')}</dd>
    <dt>{tr('labels.scale')}</dt><dd>{d.scale.slice(0, 2).join(' · ')}</dd>
  </dl>
  <div class="links">
    <a class="btn btn-primary" href={href}>{tr('actions.caseStudy')} →</a>
    {d.links.live && <a class="btn" href={d.links.live} target="_blank" rel="noopener">{tr('actions.live')} ↗</a>}
    {d.links.github && <a class="btn" href={d.links.github} target="_blank" rel="noopener">{tr('actions.github')} ↗</a>}
  </div>
</article>
<style>
  .work { display: flex; flex-direction: column; }
  .head { display: flex; align-items: center; gap: 0.65rem; margin-bottom: 1.1rem; }
  .head a { color: inherit; }
  .body { font-size: 0.95rem; line-height: 1.55; color: color-mix(in srgb, var(--fg) 78%, var(--bg)); margin-bottom: 1.5rem; }
  .waffle-wrap { margin-bottom: 1.6rem; }
  .spec-grid { margin-bottom: 1.75rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: auto; }
</style>
