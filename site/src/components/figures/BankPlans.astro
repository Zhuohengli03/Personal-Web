---
// Exhibit 5 — the two mail plans as 8,000-letter bars split by segment, with each piece's expected profit.
import data from '../../data/figures/bank.json';
import type { Locale } from '../../i18n';
interface Props {
  locale: Locale;
  t: { planA: string; planB: string; letters: string; profit: string };
  names: { noDataShort: string; ages: Record<string, string>; bands: Record<string, string> };
}
const { t, names, locale } = Astro.props;
const numLocale = locale === 'zh' ? 'zh-CN' : 'en-US';
const budget = data.totals.budget;
const seg = (id: number) => data.segments.find((s) => s.id === id)!;
const name = (id: number) => { const s = seg(id); return s.age ? `${names.ages[s.age]} · ${names.bands[s.band!]}` : names.noDataShort; };
const money = (v: number) => `${v < 0 ? '−' : ''}$${Math.abs(v).toLocaleString(numLocale)}`;
const plans = [
  { key: 'A', title: t.planA, ...data.plans.A },
  { key: 'B', title: t.planB, ...data.plans.B },
];
---
<div class="plans">
  {plans.map((p) => (
    <section class="plan" data-plan={p.key}>
      <header>
        <h4>{p.title}</h4>
        <p class="total">{money(p.profit)}<span>{t.profit}</span></p>
      </header>
      <div class="bar" role="presentation">
        {p.mail.map((m) => (
          <span class:list={['piece', { loss: m.profit < 0 }]} style={`flex:${m.n / budget}`} title={`${name(m.id)} · ${m.n.toLocaleString(numLocale)} ${t.letters} · ${money(m.profit)}`}></span>
        ))}
      </div>
      <ol class="rows">
        {p.mail.map((m) => (
          <li class:list={{ loss: m.profit < 0 }}>
            <span class="nm">{name(m.id)}</span>
            <span class="n">{m.n.toLocaleString(numLocale)} {t.letters}</span>
            <span class="pf">{money(m.profit)}</span>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>
<style>
  .plans { display: grid; gap: 2rem; }
  header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  h4 { margin: 0; font-family: var(--font-sans); font-size: 0.9rem; font-weight: 600; letter-spacing: -0.01em; }
  .total { margin: 0; font-family: var(--font-serif); font-size: 1.6rem; line-height: 1; color: var(--fg); }
  .total span { margin-left: 0.5rem; font-family: var(--font-mono); font-size: 0.68rem; color: var(--fg-muted); }
  [data-plan='A'] .total { color: var(--accent); }
  .bar { display: flex; gap: 2px; height: 22px; border-radius: 4px; overflow: hidden; }
  .piece { background: var(--accent); }
  .piece:nth-child(even) { background: color-mix(in srgb, var(--accent) 60%, var(--bg)); }
  .piece.loss { background: repeating-linear-gradient(135deg, color-mix(in srgb, var(--fg) 45%, var(--bg)) 0 4px, color-mix(in srgb, var(--fg) 20%, var(--bg)) 4px 8px); }
  .rows { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.3rem; }
  .rows li { display: grid; grid-template-columns: minmax(0, 1fr) auto 6.5rem; gap: 1rem; font-size: 0.82rem; font-variant-numeric: tabular-nums; }
  .nm { color: var(--fg); }
  .n { font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-muted); }
  .pf { font-family: var(--font-mono); font-size: 0.75rem; text-align: right; color: var(--fg); }
  .rows li.loss .pf { color: var(--fg-muted); }
  @media (max-width: 560px) { .rows li { grid-template-columns: minmax(0, 1fr) auto; } .n { display: none; } }
</style>
