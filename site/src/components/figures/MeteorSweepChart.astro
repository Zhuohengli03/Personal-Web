---
// Exhibit 2 — the app's own impact physics across asteroid diameters: crater diameter and blast radius, log–log,
// two panels on one diameter axis. Values come from calling the app's functions (scripts/meteor-shoot.mjs).
import data from '../../data/figures/meteor.json';
import type { Locale } from '../../i18n';
interface Props { locale: Locale; t: { crater: string; blast: string; diameter: string; energy: string; depth: string; seismic: string; tsunami: string; mt: string } }
const { t, locale } = Astro.props;
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';
const W = 960, L = 60, R = 24;
const rows = data.sweep.rows;
const f = (v: number) => v.toFixed(1);
const lx = (d: number) => L + ((Math.log10(d) - 1) / (Math.log10(2000) - 1)) * (W - L - R);
// panel A: crater diameter in km, 0.1 … 100
const A_T = 18, A_H = 150;
const ya = (km: number) => A_T + (1 - (Math.log10(km) + 1) / 3) * A_H;
// panel B: blast radius in km, 1 … 1000
const B_T = A_T + A_H + 44, B_H = 150;
const yb = (km: number) => B_T + (1 - Math.log10(km) / 3) * B_H;
const H = B_T + B_H + 36;
const xTicks = [10, 20, 50, 100, 200, 500, 1000, 2000];
const craterPath = rows.map((r, i) => `${i ? 'L' : 'M'}${f(lx(r.d))} ${f(ya(r.crater / 1000))}`).join(' ');
const blastPath = rows.map((r, i) => `${i ? 'L' : 'M'}${f(lx(r.d))} ${f(yb(r.blastKm))}`).join(' ');
const first = rows[0], last = rows[rows.length - 1];
const fmt = (v: number, d = 1) => v.toLocaleString(dateLocale, { maximumFractionDigits: d });
---
<div class="chart" data-sweep-chart>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${t.crater}; ${t.blast}`}>
    <text class="panel" x={L} y={A_T - 6}>{t.crater}</text>
    <g class="grid">{[0.1, 1, 10, 100].map((v) => (<g><line x1={L} x2={W - R} y1={f(ya(v))} y2={f(ya(v))} /><text x={L - 8} y={f(ya(v))} text-anchor="end" dominant-baseline="middle">{v}</text></g>))}</g>
    <path class="line" d={craterPath} />
    {rows.map((r) => <circle class="dot" cx={f(lx(r.d))} cy={f(ya(r.crater / 1000))} r="4" />)}
    <text class="val" x={f(lx(first.d) + 8)} y={f(ya(first.crater / 1000) - 8)}>{fmt(first.crater / 1000, 2)} km</text>
    <text class="val" x={f(lx(last.d) - 8)} y={f(ya(last.crater / 1000) + 16)} text-anchor="end">{fmt(last.crater / 1000)} km</text>

    <text class="panel" x={L} y={B_T - 8}>{t.blast}</text>
    <g class="grid">{[1, 10, 100, 1000].map((v) => (<g><line x1={L} x2={W - R} y1={f(yb(v))} y2={f(yb(v))} /><text x={L - 8} y={f(yb(v))} text-anchor="end" dominant-baseline="middle">{v}</text></g>))}</g>
    <path class="line muted" d={blastPath} />
    {rows.map((r) => <circle class="dot muted" cx={f(lx(r.d))} cy={f(yb(r.blastKm))} r="4" />)}
    <text class="val" x={f(lx(first.d) + 8)} y={f(yb(first.blastKm) - 8)}>{fmt(first.blastKm)} km</text>
    <text class="val" x={f(lx(last.d) - 8)} y={f(yb(last.blastKm) + 16)} text-anchor="end">{fmt(last.blastKm, 0)} km</text>
    <g class="xaxis">{xTicks.map((v) => <text x={f(lx(v))} y={H - 10} text-anchor="middle">{v}</text>)}<text class="axis" x={W - R} y={H - 24} text-anchor="end">{t.diameter}</text></g>
    <g class="hover" display="none"><line class="xline" y1={A_T} y2={B_T + B_H} /></g>
  </svg>
  <div class="tip" hidden></div>
  <script type="application/json" data-points set:html={JSON.stringify({ rows: rows.map((r) => ({ x: lx(r.d), ...r })), W, dateLocale, labels: { diameter: t.diameter, energy: t.energy, mt: t.mt, crater: t.crater, depth: t.depth, blast: t.blast, seismic: t.seismic, tsunami: t.tsunami } })} />
</div>
<style>
  .chart { position: relative; }
  svg { width: 100%; height: auto; display: block; font-family: var(--font-mono); font-size: 11px; }
  .panel, .axis { fill: var(--fg); font-family: var(--font-sans); font-size: 12px; font-weight: 500; }
  .axis { fill: var(--fg-muted); font-weight: 400; font-size: 11px; }
  .grid line { stroke: var(--rule); }
  .grid text, .xaxis text { fill: var(--fg-muted); }
  .line { fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linejoin: round; }
  .line.muted { stroke: var(--fg-muted); }
  .dot { fill: var(--accent); stroke: var(--bg); stroke-width: 2; }
  .dot.muted { fill: var(--fg-muted); }
  .val { fill: var(--fg-muted); }
  .hover .xline { stroke: var(--fg-muted); stroke-dasharray: 2 3; }
  .tip { position: absolute; pointer-events: none; transform: translate(-50%, calc(-100% - 10px)); background: var(--fg); color: var(--bg); font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.6; padding: 0.35rem 0.55rem; border-radius: 6px; white-space: pre-line; width: max-content; max-width: 100%; }
</style>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-sweep-chart]')) {
    const cfg = JSON.parse(root.querySelector('[data-points]')?.textContent ?? '{}') as {
      rows: { x: number; d: number; mt: number; crater: number; depth: number; blastKm: number; seismic: number; tsunamiM: number }[]; W: number; dateLocale: string;
      labels: Record<string, string>;
    };
    const svg = root.querySelector('svg')!, hover = root.querySelector<SVGGElement>('.hover')!, xline = hover.querySelector<SVGLineElement>('.xline')!, tip = root.querySelector<HTMLElement>('.tip')!;
    const n = (v: number, d = 1) => v.toLocaleString(cfg.dateLocale, { maximumFractionDigits: d });
    svg.addEventListener('pointermove', (e: PointerEvent) => {
      const r = svg.getBoundingClientRect(); const px = ((e.clientX - r.left) / r.width) * cfg.W;
      let best = 0; cfg.rows.forEach((p, i) => { if (Math.abs(p.x - px) < Math.abs(cfg.rows[best].x - px)) best = i; });
      const p = cfg.rows[best];
      xline.setAttribute('x1', String(p.x)); xline.setAttribute('x2', String(p.x)); hover.setAttribute('display', 'inline'); tip.hidden = false;
      tip.textContent = [`${cfg.labels.diameter.replace(/\s*[（(].*$/, '')} ${p.d} m`, `${cfg.labels.energy} ${p.mt < 1 ? n(p.mt, 3) : n(p.mt, 0)} ${cfg.labels.mt}`, `${cfg.labels.crater.replace(/\s*[（(].*$/, '')} ${n(p.crater / 1000, 2)} km · ${cfg.labels.depth} ${n(p.depth, 0)} m`, `${cfg.labels.blast.replace(/\s*[（(].*$/, '')} ${n(p.blastKm)} km`, `${cfg.labels.seismic} ${n(p.seismic)}`, `${cfg.labels.tsunami} ${n(p.tsunamiM)} m`].join('\n');
      const half = tip.getBoundingClientRect().width / 2;
      tip.style.left = `${Math.max(half, Math.min(r.width - half, (p.x / cfg.W) * r.width))}px`; tip.style.top = `${Math.max(0, e.clientY - r.top - 8)}px`;
    });
    svg.addEventListener('pointerleave', () => { hover.setAttribute('display', 'none'); tip.hidden = true; });
  }
</script>
