---
// Exhibit 4 — CNEOS fireballs since 2015: events per year (bars) and summed impact energy per year (bars), one year axis.
import data from '../../data/figures/meteor.json';
import type { Locale } from '../../i18n';
interface Props { locale: Locale; t: { count: string; energy: string; biggest: string; events: string; kt: string } }
const { t, locale } = Astro.props;
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';
const W = 960, L = 56, R = 24;
const years = data.fireballs.years;
const n = years.length, slot = (W - L - R) / n;
const xc = (i: number) => L + slot * (i + 0.5);
const f = (v: number) => v.toFixed(1);
const A_T = 18, A_H = 120;
const cMax = Math.ceil(Math.max(...years.map((y) => y.n)) / 20) * 20;
const ya = (v: number) => A_T + (1 - v / cMax) * A_H;
const B_T = A_T + A_H + 44, B_H = 120;
const eMax = Math.ceil(Math.max(...years.map((y) => y.kt)) / 20) * 20;
const yb = (v: number) => B_T + (1 - v / eMax) * B_H;
const H = B_T + B_H + 34;
const big = years.reduce((a, y, i) => (y.kt > years[a].kt ? i : a), 0);
---
<div class="chart" data-fireball-chart>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${t.count}; ${t.energy}`}>
    <text class="panel" x={L} y={A_T - 6}>{t.count}</text>
    <g class="grid">{[0, cMax / 2, cMax].map((v) => (<g><line x1={L} x2={W - R} y1={f(ya(v))} y2={f(ya(v))} /><text x={L - 8} y={f(ya(v))} text-anchor="end" dominant-baseline="middle">{v}</text></g>))}</g>
    {years.map((y, i) => (<g><rect class="bar" x={f(xc(i) - slot * 0.3)} y={f(ya(y.n))} width={f(slot * 0.6)} height={f(Math.max(1, ya(0) - ya(y.n)))} rx="2" /><text class="val" x={f(xc(i))} y={f(ya(y.n) - 6)} text-anchor="middle">{y.n}</text></g>))}
    <text class="panel" x={L} y={B_T - 8}>{t.energy}</text>
    <g class="grid">{[0, eMax / 2, eMax].map((v) => (<g><line x1={L} x2={W - R} y1={f(yb(v))} y2={f(yb(v))} /><text x={L - 8} y={f(yb(v))} text-anchor="end" dominant-baseline="middle">{v}</text></g>))}</g>
    {years.map((y, i) => <rect class:list={['bar', 'energy', { big: i === big }]} x={f(xc(i) - slot * 0.3)} y={f(yb(y.kt))} width={f(slot * 0.6)} height={f(Math.max(1, yb(0) - yb(y.kt)))} rx="2" />)}
    <text class="val" x={f(xc(big))} y={f(yb(years[big].kt) - 6)} text-anchor="middle">{t.biggest}</text>
    <g class="xaxis">{years.map((y, i) => <text x={f(xc(i))} y={H - 10} text-anchor="middle">{y.year}</text>)}</g>
    <g class="hover" display="none"><line class="xline" y1={A_T} y2={B_T + B_H} /></g>
  </svg>
  <div class="tip" hidden></div>
  <script type="application/json" data-points set:html={JSON.stringify({ years, L, R, W, dateLocale, labels: { events: t.events, kt: t.kt } })} />
</div>
<style>
  .chart { position: relative; }
  svg { width: 100%; height: auto; display: block; font-family: var(--font-mono); font-size: 11px; }
  .panel { fill: var(--fg); font-family: var(--font-sans); font-size: 12px; font-weight: 500; }
  .grid line { stroke: var(--rule); }
  .grid text, .xaxis text { fill: var(--fg-muted); }
  .bar { fill: color-mix(in srgb, var(--fg) 28%, var(--bg)); }
  .bar.energy { fill: color-mix(in srgb, var(--accent) 55%, var(--bg)); }
  .bar.energy.big { fill: var(--accent); }
  .val { fill: var(--fg-muted); }
  .hover .xline { stroke: var(--fg-muted); stroke-dasharray: 2 3; }
  .tip { position: absolute; pointer-events: none; transform: translate(-50%, calc(-100% - 10px)); background: var(--fg); color: var(--bg); font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.6; padding: 0.35rem 0.55rem; border-radius: 6px; white-space: pre-line; width: max-content; max-width: 100%; }
</style>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-fireball-chart]')) {
    const cfg = JSON.parse(root.querySelector('[data-points]')?.textContent ?? '{}') as { years: { year: string; n: number; kt: number }[]; L: number; R: number; W: number; dateLocale: string; labels: { events: string; kt: string } };
    const svg = root.querySelector('svg')!, hover = root.querySelector<SVGGElement>('.hover')!, xline = hover.querySelector<SVGLineElement>('.xline')!, tip = root.querySelector<HTMLElement>('.tip')!;
    const slot = (cfg.W - cfg.L - cfg.R) / cfg.years.length;
    svg.addEventListener('pointermove', (e: PointerEvent) => {
      const r = svg.getBoundingClientRect(); const px = ((e.clientX - r.left) / r.width) * cfg.W;
      const i = Math.max(0, Math.min(cfg.years.length - 1, Math.floor((px - cfg.L) / slot))); const y = cfg.years[i]; const cx = cfg.L + slot * (i + 0.5);
      xline.setAttribute('x1', String(cx)); xline.setAttribute('x2', String(cx)); hover.setAttribute('display', 'inline'); tip.hidden = false;
      tip.textContent = [y.year, `${y.n} ${cfg.labels.events}`, `${y.kt.toLocaleString(cfg.dateLocale)} ${cfg.labels.kt}`].join('\n');
      const half = tip.getBoundingClientRect().width / 2;
      tip.style.left = `${Math.max(half, Math.min(r.width - half, (cx / cfg.W) * r.width))}px`; tip.style.top = `${Math.max(0, e.clientY - r.top - 8)}px`;
    });
    svg.addEventListener('pointerleave', () => { hover.setAttribute('display', 'none'); tip.hidden = true; });
  }
</script>
