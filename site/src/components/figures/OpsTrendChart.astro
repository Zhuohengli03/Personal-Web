---
// Exhibit 3 — October day by day: units sold (bars) and the number of selling listings with zero inventory (dots).
// Pure SVG at build time from ops.json; a small script adds a crosshair tooltip.
import data from '../../data/figures/ops.json';
import type { Locale } from '../../i18n';
interface Props { locale: Locale; t: { units: string; oos: string; peak: string; gmv: string; oosShort: string } }
const { t, locale } = Astro.props;
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';

const W = 960, L = 56, R = 24;
const days = data.daily;
const n = days.length;
const slot = (W - L - R) / n;
const xc = (i: number) => L + slot * (i + 0.5);
const f = (v: number) => v.toFixed(1);

// panel A: units
const A_T = 18, A_H = 170;
const uMax = Math.ceil(Math.max(...days.map((d) => d.units)) / 500) * 500;
const ya = (v: number) => A_T + (1 - v / uMax) * A_H;
const aTicks = Array.from({ length: uMax / 500 + 1 }, (_, i) => i * 500);
const peak = days.reduce((a, d, i) => (d.units > days[a].units ? i : a), 0);
// panel B: out-of-stock count
const B_T = A_T + A_H + 44, B_H = 100;
const oMax = 25;
const yb = (v: number) => B_T + (1 - v / oMax) * B_H;
const H = B_T + B_H + 34;
const fmtDay = (iso: string) => new Date(iso).toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', timeZone: 'UTC' });
const fmtN = (v: number) => v.toLocaleString(dateLocale);
const oosPath = days.map((d, i) => `${i ? 'L' : 'M'}${f(xc(i))} ${f(yb(d.outOfStock))}`).join(' ');
---
<div class="chart" data-trend-chart>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${t.units}; ${t.oos}`}>
    <text class="panel" x={L} y={A_T - 6}>{t.units}</text>
    <g class="grid">
      {aTicks.map((v) => (<g><line x1={L} x2={W - R} y1={f(ya(v))} y2={f(ya(v))} /><text x={L - 8} y={f(ya(v))} text-anchor="end" dominant-baseline="middle">{fmtN(v)}</text></g>))}
    </g>
    {days.map((d, i) => (
      <g class="bar">
        <rect x={f(xc(i) - slot * 0.34)} y={f(ya(d.units))} width={f(slot * 0.68)} height={f(Math.max(1, ya(0) - ya(d.units)))} rx="2" />
        {i === peak && <text class="val" x={f(xc(i))} y={f(ya(d.units) - 6)} text-anchor="middle">{t.peak} {fmtN(d.units)}</text>}
        {i === n - 1 && <text class="val" x={f(xc(i))} y={f(ya(d.units) - 6)} text-anchor="middle">{fmtN(d.units)}</text>}
      </g>
    ))}

    <text class="panel" x={L} y={B_T - 8}>{t.oos}</text>
    <g class="grid">
      {[0, 10, 20].map((v) => (<g><line x1={L} x2={W - R} y1={f(yb(v))} y2={f(yb(v))} /><text x={L - 8} y={f(yb(v))} text-anchor="end" dominant-baseline="middle">{v}</text></g>))}
    </g>
    <path class="oos" d={oosPath} />
    {days.map((d, i) => <circle class="dot" cx={f(xc(i))} cy={f(yb(d.outOfStock))} r="3.5" />)}
    <text class="val" x={f(xc(n - 1) + 8)} y={f(yb(days[n - 1].outOfStock))} dominant-baseline="middle">{days[n - 1].outOfStock}</text>

    <g class="xaxis">
      {days.map((d, i) => i % 5 === 0 && <text x={f(xc(i))} y={H - 10} text-anchor="middle">{fmtDay(d.d)}</text>)}
    </g>
    <g class="hover" display="none"><line class="xline" y1={A_T} y2={B_T + B_H} /></g>
  </svg>
  <div class="tip" hidden></div>
  <script type="application/json" data-points set:html={JSON.stringify({ days: days.map((d) => ({ d: d.d, units: d.units, gmv: d.gmv, oos: d.outOfStock })), L, R, W, dateLocale, labels: { units: t.units, gmv: t.gmv, oos: t.oosShort } })} />
</div>
<style>
  .chart { position: relative; }
  svg { width: 100%; height: auto; display: block; font-family: var(--font-mono); font-size: 11px; }
  .panel { fill: var(--fg); font-family: var(--font-sans); font-size: 12px; font-weight: 500; }
  .grid line { stroke: var(--rule); }
  .grid text, .xaxis text { fill: var(--fg-muted); }
  .bar rect { fill: var(--accent); }
  .val { fill: var(--fg-muted); }
  .oos { fill: none; stroke: var(--fg-faint); stroke-width: 1.2; }
  .dot { fill: var(--bg); stroke: var(--fg); stroke-width: 1.6; }
  .hover .xline { stroke: var(--fg-muted); stroke-dasharray: 2 3; }
  .tip { position: absolute; pointer-events: none; transform: translate(-50%, calc(-100% - 10px)); background: var(--fg); color: var(--bg); font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.6; padding: 0.35rem 0.55rem; border-radius: 6px; white-space: pre-line; width: max-content; max-width: 100%; }
</style>
<script>
  // Crosshair + tooltip: snap to the nearest day.
  for (const root of document.querySelectorAll<HTMLElement>('[data-trend-chart]')) {
    const cfg = JSON.parse(root.querySelector('[data-points]')?.textContent ?? '{}') as {
      days: { d: string; units: number; gmv: number; oos: number }[]; L: number; R: number; W: number; dateLocale: string;
      labels: { units: string; gmv: string; oos: string };
    };
    const svg = root.querySelector('svg')!;
    const hover = root.querySelector<SVGGElement>('.hover')!;
    const xline = hover.querySelector<SVGLineElement>('.xline')!;
    const tip = root.querySelector<HTMLElement>('.tip')!;
    const slot = (cfg.W - cfg.L - cfg.R) / cfg.days.length;
    const fmt = (d: string) => new Date(d).toLocaleDateString(cfg.dateLocale, { month: 'short', day: 'numeric', timeZone: 'UTC' });
    svg.addEventListener('pointermove', (e: PointerEvent) => {
      const r = svg.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width) * cfg.W;
      const i = Math.max(0, Math.min(cfg.days.length - 1, Math.floor((px - cfg.L) / slot)));
      const d = cfg.days[i];
      const cx = cfg.L + slot * (i + 0.5);
      xline.setAttribute('x1', String(cx)); xline.setAttribute('x2', String(cx));
      hover.setAttribute('display', 'inline');
      tip.hidden = false;
      tip.textContent = [fmt(d.d), `${cfg.labels.units} ${d.units.toLocaleString(cfg.dateLocale)}`, `${cfg.labels.gmv} ${d.gmv.toLocaleString(cfg.dateLocale)}`, `${cfg.labels.oos} ${d.oos}`].join('\n');
      const halfWidth = tip.getBoundingClientRect().width / 2;
      tip.style.left = `${Math.max(halfWidth, Math.min(r.width - halfWidth, (cx / cfg.W) * r.width))}px`;
      tip.style.top = `${Math.max(0, e.clientY - r.top - 8)}px`;
    });
    svg.addEventListener('pointerleave', () => { hover.setAttribute('display', 'none'); tip.hidden = true; });
  }
</script>
