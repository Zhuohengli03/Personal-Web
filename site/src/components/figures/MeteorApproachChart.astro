---
// Exhibit 3 — close approaches pulled through the project's backend: date on x, distance in lunar distances on a log y,
// the Moon's orbit as a reference line; filled dots have passed on the pull date, hollow ones are upcoming.
import data from '../../data/figures/meteor.json';
import type { Locale } from '../../i18n';
interface Props { locale: Locale; t: { ld: string; moon: string; dist: string; vel: string; past: string; upcoming: string } }
const { t, locale } = Astro.props;
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';
const W = 960, H = 340, L = 60, R = 24, T = 20, B = 40;
const pts = data.approaches.points;
const jd0 = Math.min(...pts.map((p) => p.jd)), jd1 = Math.max(...pts.map((p) => p.jd));
const x = (jd: number) => L + ((jd - jd0) / (jd1 - jd0)) * (W - L - R);
const yMin = Math.log10(0.03), yMax = Math.log10(30);
const y = (ld: number) => T + (1 - (Math.log10(Math.max(0.03, ld)) - yMin) / (yMax - yMin)) * (H - T - B);
const f = (v: number) => v.toFixed(1);
// Julian day → calendar date (UTC)
const jdToDate = (jd: number) => new Date((jd - 2440587.5) * 86400000);
const pulled = new Date(data.pulledAt + 'T00:00:00Z');
const pulledJd = pulled.getTime() / 86400000 + 2440587.5;
const fmtDay = (d: Date) => d.toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', timeZone: 'UTC' });
const weeks = Array.from({ length: Math.floor((jd1 - jd0) / 7) + 1 }, (_, i) => jd0 + i * 7);
const closest = pts.reduce((a, p) => (p.dist < a.dist ? p : a), pts[0]);
---
<div class="chart" data-approach-chart>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t.dist}>
    <g class="grid">{[0.1, 1, 10].map((v) => (<g><line x1={L} x2={W - R} y1={f(y(v))} y2={f(y(v))} /><text x={L - 8} y={f(y(v))} text-anchor="end" dominant-baseline="middle">{v}</text></g>))}</g>
    <text class="axis" x={L} y={T - 6}>{t.ld}</text>
    <g class="ref"><line x1={L} x2={W - R} y1={f(y(1))} y2={f(y(1))} /><text x={W - R} y={f(y(1) - 6)} text-anchor="end">{t.moon}</text></g>
    {pts.map((p) => <circle class:list={['pt', { up: p.jd > pulledJd }]} cx={f(x(p.jd))} cy={f(y(p.dist))} r="4.5" />)}
    <text class="val" x={f(x(closest.jd) + 10)} y={f(y(closest.dist) + 4)}>{closest.des} · {closest.dist} {t.ld}</text>
    <g class="xaxis">{weeks.map((jd) => <text x={f(x(jd))} y={H - 12} text-anchor="middle">{fmtDay(jdToDate(jd))}</text>)}</g>
    <g class="legend"><circle class="pt" cx={L + 6} cy={H - 34} r="4.5" /><text x={L + 16} y={H - 30}>{t.past}</text><circle class="pt up" cx={L + 86} cy={H - 34} r="4.5" /><text x={L + 96} y={H - 30}>{t.upcoming}</text></g>
  </svg>
  <div class="tip" hidden></div>
  <script type="application/json" data-points set:html={JSON.stringify({ points: pts.map((p) => ({ cx: x(p.jd), cy: y(p.dist), des: p.des, cd: p.cd, dist: p.dist, v: p.v })), W, H, labels: { ld: t.ld, dist: t.dist, vel: t.vel } })} />
</div>
<style>
  .chart { position: relative; }
  svg { width: 100%; height: auto; display: block; font-family: var(--font-mono); font-size: 11px; }
  .grid line { stroke: var(--rule); }
  .grid text, .xaxis text, .axis, .legend text { fill: var(--fg-muted); }
  .ref line { stroke: var(--fg-faint); stroke-dasharray: 4 4; }
  .ref text { fill: var(--fg-muted); }
  .pt { fill: var(--accent); fill-opacity: 0.75; stroke: var(--bg); stroke-width: 1.5; }
  .pt.up { fill: var(--bg); fill-opacity: 1; stroke: var(--accent); stroke-width: 1.6; }
  .pt.hit { fill-opacity: 1; stroke: var(--fg); }
  .val { fill: var(--fg-muted); }
  .tip { position: absolute; pointer-events: none; transform: translate(-50%, calc(-100% - 12px)); background: var(--fg); color: var(--bg); font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.6; padding: 0.35rem 0.55rem; border-radius: 6px; white-space: pre-line; width: max-content; max-width: 100%; }
</style>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-approach-chart]')) {
    const cfg = JSON.parse(root.querySelector('[data-points]')?.textContent ?? '{}') as { points: { cx: number; cy: number; des: string; cd: string; dist: number; v: number }[]; W: number; H: number; labels: Record<string, string> };
    const svg = root.querySelector('svg')!, dots = [...root.querySelectorAll<SVGCircleElement>('svg > .pt')], tip = root.querySelector<HTMLElement>('.tip')!;
    svg.addEventListener('pointermove', (e: PointerEvent) => {
      const r = svg.getBoundingClientRect(); const px = ((e.clientX - r.left) / r.width) * cfg.W, py = ((e.clientY - r.top) / r.height) * cfg.H;
      let best = -1, bd = 14 * 14; cfg.points.forEach((p, i) => { const d = (p.cx - px) ** 2 + (p.cy - py) ** 2; if (d < bd) { bd = d; best = i; } });
      dots.forEach((d, i) => d.classList.toggle('hit', i === best));
      if (best < 0) { tip.hidden = true; return; }
      const p = cfg.points[best]; tip.hidden = false;
      tip.textContent = [p.des, p.cd, `${cfg.labels.dist} ${p.dist} ${cfg.labels.ld}`, `${cfg.labels.vel} ${p.v} km/s`].join('\n');
      const half = tip.getBoundingClientRect().width / 2;
      tip.style.left = `${Math.max(half, Math.min(r.width - half, (p.cx / cfg.W) * r.width))}px`; tip.style.top = `${(p.cy / cfg.H) * r.height}px`;
    });
    svg.addEventListener('pointerleave', () => { tip.hidden = true; dots.forEach((d) => d.classList.remove('hit')); });
  }
</script>
