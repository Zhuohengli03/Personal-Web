---
// Exhibit 2 — the 21 daily holdout windows: skill against naive (bar, diverging around 0) and the share of
// hours inside the 90% interval (dot), with the nominal and achieved coverage as reference lines.
import data from '../../data/figures/dad.json';
interface Props { t: { skill: string; coverage: string; nominal: string; achieved: string } }
const { t } = Astro.props;

const W = 960, L = 60, R = 24;
const wins = data.windows;
const n = wins.length;
const slot = (W - L - R) / n;
const xc = (i: number) => L + slot * (i + 0.5);
const f = (v: number) => v.toFixed(1);

// panel A: skill
const A_T = 18, A_H = 150;
const sMin = Math.min(-0.5, ...wins.map((w) => w.skill ?? 0)), sMax = Math.max(0.5, ...wins.map((w) => w.skill ?? 0));
const ya = (v: number) => A_T + ((sMax - v) / (sMax - sMin)) * A_H;
const aTicks = [-1.5, -1, -0.5, 0, 0.5].filter((v) => v >= sMin && v <= sMax);
// panel B: coverage
const B_T = A_T + A_H + 44, B_H = 110;
const yb = (v: number) => B_T + (1 - v) * B_H;
const H = B_T + B_H + 34;
const achieved = data.metrics.coverage, nominal = data.nominalCoverage;
const fmtDay = (iso: string) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const extremes = new Set([wins.reduce((a, w, i) => ((w.skill ?? 0) > (wins[a].skill ?? 0) ? i : a), 0), wins.reduce((a, w, i) => ((w.skill ?? 0) < (wins[a].skill ?? 0) ? i : a), 0)]);
---
<svg viewBox={`0 0 ${W} ${H}`} class="windows" role="img" aria-label={`${t.skill}; ${t.coverage}`}>
  <text class="panel" x={L} y={A_T - 6}>{t.skill}</text>
  <g class="grid">
    {aTicks.map((v) => (<g><line x1={L} x2={W - R} y1={f(ya(v))} y2={f(ya(v))} class:list={{ zero: v === 0 }} /><text x={L - 8} y={f(ya(v))} text-anchor="end" dominant-baseline="middle">{v > 0 ? `+${v}` : v}</text></g>))}
  </g>
  {wins.map((w, i) => {
    const s = w.skill ?? 0;
    const y0 = ya(0), y1 = ya(s);
    return (
      <g class:list={['bar', s >= 0 ? 'pos' : 'neg']}>
        <rect x={f(xc(i) - slot * 0.32)} y={f(Math.min(y0, y1))} width={f(slot * 0.64)} height={f(Math.max(1, Math.abs(y1 - y0)))} rx="2" />
        {extremes.has(i) && <text class="val" x={f(xc(i))} y={f(s >= 0 ? y1 - 5 : y1 + 12)} text-anchor="middle">{s > 0 ? '+' : ''}{(s * 100).toFixed(0)}%</text>}
      </g>
    );
  })}

  <text class="panel" x={L} y={B_T - 8}>{t.coverage}</text>
  <g class="grid">
    {[0, 0.5, 1].map((v) => (<g><line x1={L} x2={W - R} y1={f(yb(v))} y2={f(yb(v))} /><text x={L - 8} y={f(yb(v))} text-anchor="end" dominant-baseline="middle">{Math.round(v * 100)}%</text></g>))}
  </g>
  <g class="ref nominal"><line x1={L} x2={W - R} y1={f(yb(nominal))} y2={f(yb(nominal))} /><text x={W - R} y={f(yb(nominal) - 5)} text-anchor="end">{t.nominal} {Math.round(nominal * 100)}%</text></g>
  <g class="ref achieved"><line x1={L} x2={W - R} y1={f(yb(achieved))} y2={f(yb(achieved))} /><text x={W - R} y={f(yb(achieved) + 13)} text-anchor="end">{t.achieved} {Math.round(achieved * 100)}%</text></g>
  {wins.map((w, i) => <circle class="cov" cx={f(xc(i))} cy={f(yb(w.coverage ?? 0))} r="4" />)}
  <g class="xaxis">
    {wins.map((w, i) => i % 3 === 0 && <text x={f(xc(i))} y={H - 10} text-anchor="middle">{fmtDay(w.origin)}</text>)}
  </g>
</svg>
<style>
  .windows { width: 100%; height: auto; display: block; font-family: var(--font-mono); font-size: 11px; }
  .panel { fill: var(--fg); font-family: var(--font-sans); font-size: 12px; font-weight: 500; }
  .grid line { stroke: var(--rule); }
  .grid line.zero { stroke: var(--fg-faint); }
  .grid text, .xaxis text { fill: var(--fg-muted); }
  .bar.pos rect { fill: var(--accent); }
  .bar.neg rect { fill: color-mix(in srgb, var(--fg) 28%, var(--bg)); }
  .val { fill: var(--fg-muted); }
  .cov { fill: var(--bg); stroke: var(--fg); stroke-width: 1.6; }
  .ref line { stroke-dasharray: 4 4; }
  .ref.nominal line { stroke: var(--fg-faint); }
  .ref.achieved line { stroke: var(--accent); }
  .ref text { fill: var(--fg-muted); }
  .ref.achieved text { fill: var(--accent); }
</style>
