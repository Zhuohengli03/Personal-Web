---
// Exhibit 4 — the best-selling listing through October: price (step line), category rank (inverted, higher = better)
// and units per day (bars), stacked on one time axis so the three can be read together. No dual axis.
import data from '../../data/figures/ops.json';
import type { Locale } from '../../i18n';
interface Props { locale: Locale; t: { price: string; rank: string; units: string; best: string; worst: string } }
const { t, locale } = Astro.props;
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';

const W = 960, L = 56, R = 24;
const s = data.topLink.series;
const n = s.length;
const slot = (W - L - R) / n;
const xc = (i: number) => L + slot * (i + 0.5);
const f = (v: number) => v.toFixed(1);
const fmtDay = (iso: string) => new Date(iso).toLocaleDateString(dateLocale, { month: 'short', day: 'numeric', timeZone: 'UTC' });

// panel P: price (step)
const P_T = 18, P_H = 90;
const prices = s.map((p) => p.price).filter((v): v is number => v !== null);
const pMin = Math.floor(Math.min(...prices) / 5) * 5, pMax = Math.ceil(Math.max(...prices) / 5) * 5;
const yp = (v: number) => P_T + (1 - (v - pMin) / (pMax - pMin)) * P_H;
const pTicks = Array.from({ length: (pMax - pMin) / 5 + 1 }, (_, i) => pMin + i * 5);
let pricePath = '', pen = false;
s.forEach((p, i) => {
  if (p.price === null) { pen = false; return; }
  pricePath += `${pen ? 'L' : 'M'}${f(xc(i) - slot / 2)} ${f(yp(p.price))} L${f(xc(i) + slot / 2)} ${f(yp(p.price))} `; pen = true;
});
const firstP = s.find((p) => p.price !== null)!, lastP = [...s].reverse().find((p) => p.price !== null)!;

// panel R: rank, inverted (rank 1 at the top)
const R_T = P_T + P_H + 44, R_H = 110;
const ranks = s.map((p) => p.rank).filter((v): v is number => v !== null);
const rMax = Math.ceil(Math.max(...ranks) / 250) * 250;
const yr = (v: number) => R_T + (v / rMax) * R_H;
const rTicks = Array.from({ length: rMax / 250 + 1 }, (_, i) => i * 250).map((v) => (v === 0 ? 1 : v));
let rankPath = '', rpen = false;
s.forEach((p, i) => {
  if (p.rank === null) { rpen = false; return; }
  rankPath += `${rpen ? 'L' : 'M'}${f(xc(i))} ${f(yr(p.rank))} `; rpen = true;
});
const best = s.reduce((a, p, i) => (p.rank !== null && (s[a].rank === null || p.rank < s[a].rank!) ? i : a), 0);
const worst = s.reduce((a, p, i) => (p.rank !== null && (s[a].rank === null || p.rank > s[a].rank!) ? i : a), 0);

// panel U: units
const U_T = R_T + R_H + 44, U_H = 90;
const uMax = Math.ceil(Math.max(...s.map((p) => p.units)) / 50) * 50;
const yu = (v: number) => U_T + (1 - v / uMax) * U_H;
const uTicks = [0, uMax / 2, uMax];
const H = U_T + U_H + 34;
---
<div class="chart" data-link-chart>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${t.price}; ${t.rank}; ${t.units}`}>
    <text class="panel" x={L} y={P_T - 6}>{t.price}</text>
    <g class="grid">
      {pTicks.map((v) => (<g><line x1={L} x2={W - R} y1={f(yp(v))} y2={f(yp(v))} /><text x={L - 8} y={f(yp(v))} text-anchor="end" dominant-baseline="middle">{v}</text></g>))}
    </g>
    <path class="price" d={pricePath.trim()} />
    <text class="val" x={f(xc(0))} y={f(yp(firstP.price!) + 14)} text-anchor="start">{firstP.price!.toFixed(2)}</text>
    <text class="val" x={f(xc(n - 1))} y={f(yp(lastP.price!) - 6)} text-anchor="end">{lastP.price!.toFixed(2)}</text>

    <text class="panel" x={L} y={R_T - 8}>{t.rank}</text>
    <g class="grid">
      {rTicks.map((v) => (<g><line x1={L} x2={W - R} y1={f(yr(v === 1 ? 0 : v))} y2={f(yr(v === 1 ? 0 : v))} /><text x={L - 8} y={f(yr(v === 1 ? 0 : v))} text-anchor="end" dominant-baseline="middle">#{v}</text></g>))}
    </g>
    <path class="rank" d={rankPath.trim()} />
    {s.map((p, i) => p.rank !== null && <circle class="dot" cx={f(xc(i))} cy={f(yr(p.rank))} r="3" />)}
    <text class="val" x={f(xc(best))} y={f(yr(s[best].rank!) - 8)} text-anchor="middle">{t.best} #{s[best].rank} · {fmtDay(s[best].d)}</text>
    <text class="val" x={f(xc(worst))} y={f(yr(s[worst].rank!) + 14)} text-anchor="end">{t.worst} #{s[worst].rank}</text>

    <text class="panel" x={L} y={U_T - 8}>{t.units}</text>
    <g class="grid">
      {uTicks.map((v) => (<g><line x1={L} x2={W - R} y1={f(yu(v))} y2={f(yu(v))} /><text x={L - 8} y={f(yu(v))} text-anchor="end" dominant-baseline="middle">{v}</text></g>))}
    </g>
    {s.map((p, i) => <rect class="bar" x={f(xc(i) - slot * 0.34)} y={f(yu(p.units))} width={f(slot * 0.68)} height={f(Math.max(1, yu(0) - yu(p.units)))} rx="2" />)}

    <g class="xaxis">
      {s.map((p, i) => i % 5 === 0 && <text x={f(xc(i))} y={H - 10} text-anchor="middle">{fmtDay(p.d)}</text>)}
    </g>
    <g class="hover" display="none"><line class="xline" y1={P_T} y2={U_T + U_H} /></g>
  </svg>
  <div class="tip" hidden></div>
  <script type="application/json" data-points set:html={JSON.stringify({ points: s, L, R, W, dateLocale, labels: { price: t.price, rank: t.rank.replace(/\s*[（(].*$/, ''), units: t.units } })} />
</div>
<style>
  .chart { position: relative; }
  svg { width: 100%; height: auto; display: block; font-family: var(--font-mono); font-size: 11px; }
  .panel { fill: var(--fg); font-family: var(--font-sans); font-size: 12px; font-weight: 500; }
  .grid line { stroke: var(--rule); }
  .grid text, .xaxis text { fill: var(--fg-muted); }
  .price { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; }
  .rank { fill: none; stroke: var(--fg-muted); stroke-width: 1.4; stroke-linejoin: round; }
  .dot { fill: var(--bg); stroke: var(--fg-muted); stroke-width: 1.4; }
  .bar { fill: color-mix(in srgb, var(--fg) 28%, var(--bg)); }
  .val { fill: var(--fg-muted); }
  .hover .xline { stroke: var(--fg-muted); stroke-dasharray: 2 3; }
  .tip { position: absolute; pointer-events: none; transform: translate(-50%, calc(-100% - 10px)); background: var(--fg); color: var(--bg); font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.6; padding: 0.35rem 0.55rem; border-radius: 6px; white-space: pre-line; width: max-content; max-width: 100%; }
</style>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-link-chart]')) {
    const cfg = JSON.parse(root.querySelector('[data-points]')?.textContent ?? '{}') as {
      points: { d: string; price: number | null; rank: number | null; units: number }[]; L: number; R: number; W: number; dateLocale: string;
      labels: { price: string; rank: string; units: string };
    };
    const svg = root.querySelector('svg')!;
    const hover = root.querySelector<SVGGElement>('.hover')!;
    const xline = hover.querySelector<SVGLineElement>('.xline')!;
    const tip = root.querySelector<HTMLElement>('.tip')!;
    const slot = (cfg.W - cfg.L - cfg.R) / cfg.points.length;
    const fmt = (d: string) => new Date(d).toLocaleDateString(cfg.dateLocale, { month: 'short', day: 'numeric', timeZone: 'UTC' });
    svg.addEventListener('pointermove', (e: PointerEvent) => {
      const r = svg.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width) * cfg.W;
      const i = Math.max(0, Math.min(cfg.points.length - 1, Math.floor((px - cfg.L) / slot)));
      const p = cfg.points[i];
      const cx = cfg.L + slot * (i + 0.5);
      xline.setAttribute('x1', String(cx)); xline.setAttribute('x2', String(cx));
      hover.setAttribute('display', 'inline');
      tip.hidden = false;
      const parts = [fmt(p.d)];
      if (p.price !== null) parts.push(`${cfg.labels.price} ${p.price.toFixed(2)}`);
      if (p.rank !== null) parts.push(`${cfg.labels.rank} #${p.rank}`);
      parts.push(`${cfg.labels.units} ${p.units}`);
      tip.textContent = parts.join('\n');
      const halfWidth = tip.getBoundingClientRect().width / 2;
      tip.style.left = `${Math.max(halfWidth, Math.min(r.width - halfWidth, (cx / cfg.W) * r.width))}px`;
      tip.style.top = `${Math.max(0, e.clientY - r.top - 8)}px`;
    });
    svg.addEventListener('pointerleave', () => { hover.setAttribute('display', 'none'); tip.hidden = true; });
  }
</script>
