---
// Exhibit 2 — one real run of the scroll loop: after each round, how many list items the page held (bars) and how
// many article links the crawler had collected (dots), on a time axis of seconds since the page opened.
import data from '../../data/figures/crawler.json';
import type { Locale } from '../../i18n';
interface Props { locale: Locale; t: { elements: string; collected: string; seconds: string; round: string; target: string; stopEnough: string; stopNoGrowth: string; stopMax: string } }
const { t, locale } = Astro.props;
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';

const W = 960, L = 56, R = 24, T = 18, PH = 220;
const H = T + PH + 40;
const rounds = data.rounds;
const n = rounds.length;
const tMax = Math.ceil(rounds[n - 1].t / 5) * 5;
const x = (s: number) => L + (s / tMax) * (W - L - R);
const yMax = Math.ceil(Math.max(data.run.need, ...rounds.map((r) => r.elements)) / 20) * 20;
const y = (v: number) => T + (1 - v / yMax) * PH;
const f = (v: number) => v.toFixed(1);
const yTicks = Array.from({ length: yMax / 20 + 1 }, (_, i) => i * 20);
const xTicks = Array.from({ length: tMax / 5 + 1 }, (_, i) => i * 5);
const barW = 10;
const linePath = rounds.map((r, i) => `${i ? 'L' : 'M'}${f(x(r.t))} ${f(y(r.collected))}`).join(' ');
const stop = data.run.stop === 'enough' ? t.stopEnough : data.run.stop === 'no-growth' ? t.stopNoGrowth : t.stopMax;
const last = rounds[n - 1];
---
<div class="chart" data-scroll-chart>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${t.elements}; ${t.collected}`}>
    <g class="grid">
      {yTicks.map((v) => (<g><line x1={L} x2={W - R} y1={f(y(v))} y2={f(y(v))} /><text x={L - 8} y={f(y(v))} text-anchor="end" dominant-baseline="middle">{v}</text></g>))}
    </g>
    <g class="ref"><line x1={L} x2={W - R} y1={f(y(data.run.need))} y2={f(y(data.run.need))} /><text x={L + 6} y={f(y(data.run.need) - 6)}>{t.target} {data.run.need}</text></g>
    {rounds.map((r) => <rect class="bar" x={f(x(r.t) - barW / 2)} y={f(y(r.elements))} width={barW} height={f(Math.max(1, y(0) - y(r.elements)))} rx="2" />)}
    <path class="line" d={linePath} />
    {rounds.map((r) => <circle class="dot" cx={f(x(r.t))} cy={f(y(r.collected))} r="4.5" />)}
    <text class="val" x={f(x(last.t) - 10)} y={f(y(last.collected) + 18)} text-anchor="end">{t.collected} {last.collected} · {stop}</text>
    <text class="val" x={f(x(rounds[0].t))} y={f(y(rounds[0].elements) - 8)} text-anchor="start">{t.elements} {rounds[0].elements}</text>
    <g class="xaxis">
      {xTicks.map((s) => <text x={f(x(s))} y={H - 10} text-anchor="middle">{s}{t.seconds}</text>)}
    </g>
    <g class="hover" display="none"><line class="xline" y1={T} y2={T + PH} /></g>
  </svg>
  <div class="tip" hidden></div>
  <script type="application/json" data-points set:html={JSON.stringify({ rounds: rounds.map((r) => ({ x: x(r.t), t: r.t, round: r.round, scrolls: r.scrolls, elements: r.elements, collected: r.collected })), W, dateLocale, labels: { round: t.round, elements: t.elements, collected: t.collected, seconds: t.seconds } })} />
</div>
<style>
  .chart { position: relative; }
  svg { width: 100%; height: auto; display: block; font-family: var(--font-mono); font-size: 11px; }
  .grid line { stroke: var(--rule); }
  .grid text, .xaxis text { fill: var(--fg-muted); }
  .ref line { stroke: var(--fg-faint); stroke-dasharray: 4 4; }
  .ref text { fill: var(--fg-muted); }
  .bar { fill: color-mix(in srgb, var(--fg) 28%, var(--bg)); }
  .line { fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linejoin: round; }
  .dot { fill: var(--accent); stroke: var(--bg); stroke-width: 2; }
  .val { fill: var(--fg-muted); }
  .hover .xline { stroke: var(--fg-muted); stroke-dasharray: 2 3; }
  .tip { position: absolute; pointer-events: none; transform: translate(-50%, calc(-100% - 10px)); background: var(--fg); color: var(--bg); font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.6; padding: 0.35rem 0.55rem; border-radius: 6px; white-space: pre-line; width: max-content; max-width: 100%; }
</style>
<script>
  // Crosshair + tooltip: snap to the nearest round.
  for (const root of document.querySelectorAll<HTMLElement>('[data-scroll-chart]')) {
    const cfg = JSON.parse(root.querySelector('[data-points]')?.textContent ?? '{}') as {
      rounds: { x: number; t: number; round: number; scrolls: number; elements: number; collected: number }[]; W: number; dateLocale: string;
      labels: { round: string; elements: string; collected: string; seconds: string };
    };
    const svg = root.querySelector('svg')!;
    const hover = root.querySelector<SVGGElement>('.hover')!;
    const xline = hover.querySelector<SVGLineElement>('.xline')!;
    const tip = root.querySelector<HTMLElement>('.tip')!;
    svg.addEventListener('pointermove', (e: PointerEvent) => {
      const r = svg.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width) * cfg.W;
      let best = 0; cfg.rounds.forEach((p, i) => { if (Math.abs(p.x - px) < Math.abs(cfg.rounds[best].x - px)) best = i; });
      const p = cfg.rounds[best];
      xline.setAttribute('x1', String(p.x)); xline.setAttribute('x2', String(p.x));
      hover.setAttribute('display', 'inline');
      tip.hidden = false;
      tip.textContent = [`${cfg.labels.round} ${p.round + 1} · ${p.t}${cfg.labels.seconds}`, `${cfg.labels.elements} ${p.elements}`, `${cfg.labels.collected} ${p.collected}`].join('\n');
      const halfWidth = tip.getBoundingClientRect().width / 2;
      tip.style.left = `${Math.max(halfWidth, Math.min(r.width - halfWidth, (p.x / cfg.W) * r.width))}px`;
      tip.style.top = `${Math.max(0, e.clientY - r.top - 8)}px`;
    });
    svg.addEventListener('pointerleave', () => { hover.setAttribute('display', 'none'); tip.hidden = true; });
  }
</script>
