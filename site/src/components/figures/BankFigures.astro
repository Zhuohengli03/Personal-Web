---
// The exhibit set for the "Checking-account acquisition targeting" case: stat strip, the two-model value
// chain, the check of the provided score, the opposite drivers, the nine segments, the two mail plans
// and three prospects scored by hand.
import type { Locale } from '../../i18n';
import text from '../../data/figures/bank-text.json';
import SpecRow from '../SpecRow.astro';
import Pipeline from './Pipeline.astro';
import BankDecileChart from './BankDecileChart.astro';
import BankDriverChart from './BankDriverChart.astro';
import BankSegmentChart from './BankSegmentChart.astro';
import BankPlans from './BankPlans.astro';
import BankTrio from './BankTrio.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = text[locale];
---
<section class="exhibits" data-exhibits>
  <p class="eyebrow center">{t.exhibits}</p>
  <p class="note center">{t.note}</p>
  <div class="strip reveal"><SpecRow items={t.stats} columns={4} /></div>
  <div class="data reveal" data-case-data>
    <p class="eyebrow">{t.data.label}</p>
    <ul>
      {t.data.files.map((file) => (
        <li><a class="btn" href={file.href} download data-umami-event="data-download" data-umami-event-file={file.name}>{file.name} ↓</a><span class="hint">{file.hint}</span></li>
      ))}
    </ul>
  </div>

  <figure class="exhibit reveal">
    <div class="head"><h3>{t.fig1.title}</h3></div>
    <Pipeline nodes={t.fig1.nodes} />
    <figcaption>{t.fig1.caption}</figcaption>
  </figure>

  <figure class="exhibit reveal">
    <div class="head"><h3>{t.fig2.title}</h3><p class="sub">{t.fig2.sub}</p></div>
    <BankDecileChart t={t.fig2} locale={locale} />
    <figcaption>{t.fig2.caption}</figcaption>
  </figure>

  <figure class="exhibit reveal">
    <div class="head"><h3>{t.fig3.title}</h3><p class="sub">{t.fig3.sub}</p></div>
    <BankDriverChart t={t.fig3} />
    <figcaption>{t.fig3.caption}</figcaption>
  </figure>

  <figure class="exhibit reveal">
    <div class="head"><h3>{t.fig4.title}</h3><p class="sub">{t.fig4.sub}</p></div>
    <BankSegmentChart t={t.fig4} locale={locale} />
    <figcaption>{t.fig4.caption}</figcaption>
  </figure>

  <figure class="exhibit reveal">
    <div class="head"><h3>{t.fig5.title}</h3><p class="sub">{t.fig5.sub}</p></div>
    <BankPlans t={t.fig5} names={t.fig4} locale={locale} />
    <figcaption>{t.fig5.caption}</figcaption>
  </figure>

  <figure class="exhibit reveal">
    <div class="head"><h3>{t.fig6.title}</h3><p class="sub">{t.fig6.sub}</p></div>
    <BankTrio t={t.fig6} bands={t.fig4.bands} locale={locale} />
    <figcaption>{t.fig6.caption}</figcaption>
  </figure>
</section>
<style>
  .exhibits { margin-top: 3rem; }
  .exhibits .eyebrow { margin-bottom: 0.6rem; }
  .note { max-width: var(--measure); margin: 0 auto 2.2rem; font-size: 0.85rem; line-height: 1.5; color: var(--fg-muted); text-wrap: balance; }
  .strip { margin-bottom: 2.25rem; }
  .data { margin-bottom: 3rem; }
  .data .eyebrow { margin-bottom: 0.6rem; }
  .data ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; }
  .data li { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem 0.75rem; }
  .data .btn { font-family: var(--font-mono); font-size: 0.75rem; }
  .data .hint { font-size: 0.78rem; color: var(--fg-muted); }
  .strip :global(.specrow) { grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 720px) { .strip :global(.specrow) { grid-template-columns: repeat(5, 1fr); } }
  .exhibit { margin: 0 0 3.5rem; padding: 1.5rem 1.5rem 1.25rem; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--bg); }
  .head { margin-bottom: 1.1rem; }
  h3 { font-family: var(--font-sans); font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
  .sub { margin-top: 0.3rem; font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.5; color: var(--fg-muted); }
  figcaption { margin-top: 1.1rem; font-size: 0.9rem; line-height: 1.55; color: color-mix(in srgb, var(--fg) 80%, var(--bg)); }
  @media (max-width: 560px) { .exhibit { padding: 1rem 0.9rem; } }
</style>
