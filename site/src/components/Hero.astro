---
import { t, type Locale } from '../i18n';
import Badge from './Badge.astro';
interface Props { locale: Locale; eyebrow: string; title: string; subtitle: string; email: string; badge: { name: string; line1: string; line2: string } }
const { locale, eyebrow, title, subtitle, email, badge } = Astro.props;
const tr = t(locale);
---
<section class="hero">
  <div class="wrap grid">
    <div class="badge-slot"><Badge {...badge} /></div>
    <div class="copy">
      <p class="eyebrow fade-up" data-delay="1">{eyebrow}</p>
      <h1 class="fade-up" data-delay="2">{title}</h1>
      <p class="prose fade-up" data-delay="3">{subtitle}</p>
      <div class="cta fade-up" data-delay="4">
        <a class="btn btn-primary" href={locale === 'zh' ? '/resume-zh.pdf' : '/resume-en.pdf'}>{tr('hero.resume')}</a>
        <a class="btn" href={`mailto:${email}`}>{tr('hero.email')}</a>
      </div>
    </div>
  </div>
</section>
<style>
  .hero { min-height: calc(100vh - var(--header-h)); display: grid; }
  /* Narrow: the badge hangs from the header edge, centred, above the centred copy */
  .grid { display: grid; grid-template-columns: 1fr; align-content: start; padding-bottom: 4rem; }
  .badge-slot { display: flex; justify-content: center; margin-bottom: 1.25rem; }
  .copy { text-align: center; }
  h1 { max-width: 20ch; margin: 1.25rem auto; }
  .cta { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.75rem; }
  /* Wide: two columns — copy on the left, the badge hanging from the header on the right */
  @media (min-width: 1100px) {
    .grid { grid-template-columns: minmax(0, 1fr) 300px; column-gap: 3rem; align-content: stretch; padding-bottom: 0; min-height: calc(100vh - var(--header-h)); }
    .badge-slot { order: 2; align-self: start; justify-content: flex-end; margin: 0; }
    .copy { order: 1; align-self: center; text-align: left; padding-block: 5rem; }
    .copy .prose { margin-inline: 0; }
    h1 { margin: 1.25rem 0; }
    .cta { justify-content: flex-start; }
  }
</style>
