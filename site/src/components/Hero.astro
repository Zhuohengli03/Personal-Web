---
import { t, type Locale } from '../i18n';
interface Props { locale: Locale; eyebrow: string; title: string; subtitle: string; email: string }
const { locale, eyebrow, title, subtitle, email } = Astro.props;
const tr = t(locale);
---
<section class="hero">
  <div class="wrap center">
    <p class="eyebrow fade-up" data-delay="1">{eyebrow}</p>
    <h1 class="fade-up" data-delay="2">{title}</h1>
    <p class="prose fade-up" data-delay="3">{subtitle}</p>
    <div class="cta fade-up" data-delay="4">
      <a class="btn btn-primary" href={locale === 'zh' ? '/resume-zh.pdf' : '/resume-en.pdf'}>{tr('hero.resume')}</a>
      <a class="btn" href={`mailto:${email}`}>{tr('hero.email')}</a>
    </div>
  </div>
</section>
<style>
  .hero { min-height: calc(100vh - var(--header-h)); display: grid; place-items: center; padding-block: 4rem; }
  h1 { max-width: 20ch; margin: 1.25rem auto; }
  .cta { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.75rem; }
</style>
