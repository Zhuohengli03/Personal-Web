---
// Badge.astro — a conference-style lanyard badge that drops from the header on a fabric strap and swings to rest.
// Physics: an inextensible rope — Verlet integration with one-sided distance constraints (the strap can go slack
// but barely stretches), so the badge snaps taut at the end of the drop and then swings like a pendulum under air
// drag. Draggable. Static under prefers-reduced-motion and without JS.
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';
interface Props { name: string; line1: string; line2: string }
const { name, line1, line2 } = Astro.props;
---
<div class="rig" data-badge>
  <svg class="strap" aria-hidden="true">
    <defs>
      <linearGradient id="strap-grad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#1b2540" /><stop offset="0.5" stop-color="#2b3a60" /><stop offset="1" stop-color="#1b2540" />
      </linearGradient>
      <linearGradient id="metal-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f4f4f4" /><stop offset="0.45" stop-color="#b9bcc4" /><stop offset="0.55" stop-color="#8e929b" /><stop offset="1" stop-color="#d9dbe0" />
      </linearGradient>
    </defs>
    <!-- strap: fabric body, woven highlight, stitched edge -->
    <path class="strap-body" d="" />
    <path class="strap-weave" d="" />
    <path class="strap-stitch" d="" />
    <!-- swivel clip at the strap's end -->
    <g class="clip" data-clip>
      <rect x="-7" y="-2" width="14" height="22" rx="4" fill="url(#metal-grad)" stroke="#6f737b" stroke-width="0.8" />
      <circle cx="0" cy="3" r="2.2" fill="#5e626a" />
      <rect x="-4.5" y="18" width="9" height="12" rx="2" fill="url(#metal-grad)" stroke="#6f737b" stroke-width="0.8" />
    </g>
  </svg>
  <div class="card" data-card>
    <span class="slot" aria-hidden="true"></span>
    <Image src={photo} alt={name} width={360} height={360} fit="cover" format="webp" quality={82} loading="eager" />
    <p class="name">{name}</p>
    <p class="line">{line1}</p>
    <p class="line muted">{line2}</p>
    <p class="id" aria-hidden="true">LIZHUOHENG.COM · 2027</p>
    <span class="gloss" aria-hidden="true"></span>
  </div>
</div>
<style>
  .rig {
    --w: 132px; --h: 272px; --rest: 64px; --sag: 0px; --strap-w: 11px;
    position: relative; width: 220px; height: calc(var(--rest) + var(--sag) + var(--h) + 28px); margin: 0 auto;
    pointer-events: none;
  }
  @media (min-width: 1100px) {
    .rig { --w: 150px; --h: 300px; --rest: 120px; --strap-w: 14px; height: calc(var(--rest) + var(--sag) + var(--h) + 40px); }
  }
  .strap { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .strap-body { fill: none; stroke: url(#strap-grad); stroke-width: var(--strap-w); stroke-linecap: butt; }
  .strap-weave { fill: none; stroke: rgba(255, 255, 255, 0.22); stroke-width: 2; stroke-dasharray: 2 3; stroke-linecap: round; }
  .strap-stitch { fill: none; stroke: rgba(255, 255, 255, 0.35); stroke-width: 0.8; stroke-dasharray: 3 4; }
  .clip { opacity: 0; }
  .rig[data-live] .clip { opacity: 1; }
  .card {
    position: absolute; left: 0; top: 0; width: var(--w);
    transform-origin: 50% 0;
    /* rest pose (no JS / reduced motion): hanging straight down, strap taut */
    transform: translate(110px, calc(var(--rest) + var(--sag))) translateX(-50%);
    background: linear-gradient(170deg, #ffffff 0%, #f6f6f4 100%);
    border: 1px solid rgba(0, 0, 0, 0.14); border-radius: 10px; padding: 0 0 0.6rem;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset, 0 18px 32px -14px rgba(0, 0, 0, 0.45), 0 2px 6px rgba(0, 0, 0, 0.12);
    color: #282828;
    pointer-events: auto; cursor: grab; user-select: none; touch-action: none; overflow: hidden;
  }
  .card:active { cursor: grabbing; }
  /* punched slot the clip passes through */
  .slot { position: absolute; top: 7px; left: 50%; width: 30px; height: 7px; transform: translateX(-50%); border-radius: 4px; background: #d9d7d2; box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.35); }
  .card :global(img) { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; margin-top: 22px; }
  .name { font-family: var(--font-serif); font-size: 0.92rem; line-height: 1.2; margin: 0.55rem 0.7rem 0.15rem; text-wrap: balance; }
  .line { font-family: var(--font-mono); font-size: 0.55rem; letter-spacing: 0.05em; line-height: 1.4; margin: 0 0.7rem; text-transform: uppercase; }
  .line.muted { color: #6b6866; }
  .id { display: none; font-family: var(--font-mono); font-size: 0.5rem; letter-spacing: 0.12em; margin: 0.5rem 0.7rem 0; color: #9a9896; border-top: 1px solid rgba(0, 0, 0, 0.08); padding-top: 0.35rem; }
  @media (min-width: 1100px) { .line { font-size: 0.6rem; margin: 0 0.8rem; } .name { margin-inline: 0.8rem; } .id { display: block; margin-inline: 0.8rem; } }
  /* plastic sleeve sheen */
  .gloss { position: absolute; inset: 0; pointer-events: none; border-radius: 10px;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0) 35%, rgba(255, 255, 255, 0.45) 48%, rgba(255, 255, 255, 0) 58%); }
  html.js .rig[data-live] .card { transform: none; } /* JS drives the transform from here on */
  @media (prefers-reduced-motion: reduce) {
    html.js .rig[data-live] .card { transform: translate(110px, calc(var(--rest) + var(--sag))) translateX(-50%); }
    .rig[data-live] .clip { opacity: 0; }
  }
</style>
<script>
  // ---------- physics: rope as a chain of nodes, Verlet + distance constraints ----------
  interface N { x: number; y: number; px: number; py: number }
  const G = 2200;          // px/s²
  const SEGS = 5;          // rope segments (anchor → … → card)
  const ITER = 8;          // constraint iterations per step
  const AIR = 0.012;       // velocity lost per step (air drag)
  const CARD_MASS = 6;     // the card is far heavier than a strap segment
  const SUB = 2;           // physics substeps per frame
  const MAX_DT = 1 / 30;

  const integrate = (n: N, dt: number): N => {
    const vx = (n.x - n.px) * (1 - AIR), vy = (n.y - n.py) * (1 - AIR);
    return { x: n.x + vx, y: n.y + vy + G * dt * dt, px: n.x, py: n.y };
  };

  /** One-sided constraint: only pull nodes together when a segment is longer than `len`. */
  const constrain = (nodes: N[], len: number): N[] => {
    const out = nodes.map((n) => ({ ...n }));
    for (let k = 0; k < ITER; k++) {
      for (let i = 0; i < SEGS; i++) {
        const a = out[i], b = out[i + 1];
        const dx = b.x - a.x, dy = b.y - a.y;
        const d = Math.hypot(dx, dy) || 1e-6;
        if (d <= len) continue;
        const corr = (d - len) / d;
        const wa = i === 0 ? 0 : 1;                     // the anchor never moves
        const wb = i === SEGS - 1 ? 1 / CARD_MASS : 1;  // the card barely yields to the strap
        const sum = wa + wb;
        a.x += dx * corr * (wa / sum); a.y += dy * corr * (wa / sum);
        b.x -= dx * corr * (wb / sum); b.y -= dy * corr * (wb / sum);
      }
    }
    return out;
  };

  const step = (nodes: N[], dt: number, len: number): N[] =>
    constrain(nodes.map((n, i) => (i === 0 ? n : integrate(n, dt))), len);

  // ---------- wiring ----------
  const rig = document.querySelector<HTMLElement>('[data-badge]');
  const card = rig?.querySelector<HTMLElement>('[data-card]');
  const body = rig?.querySelector<SVGPathElement>('.strap-body');
  const weave = rig?.querySelector<SVGPathElement>('.strap-weave');
  const stitch = rig?.querySelector<SVGPathElement>('.strap-stitch');
  const clip = rig?.querySelector<SVGGElement>('[data-clip]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (rig && card && body && weave && stitch && clip && !reduced) {
    const rest = parseFloat(getComputedStyle(rig).getPropertyValue('--rest')) || 120;
    const seg = rest / SEGS;
    const ax = rig.clientWidth / 2;
    rig.setAttribute('data-live', '');

    const at = (x: number, y: number): N => ({ x, y, px: x, py: y });
    const restPose = (): N[] => Array.from({ length: SEGS + 1 }, (_, i) => at(0, i * seg));
    // start bunched up above the header with a sideways nudge on the card, so the rope goes slack, then taut
    let nodes: N[] = Array.from({ length: SEGS + 1 }, (_, i) => (i === 0 ? at(0, 0) : at(4 * i, -(rest + 220) + i * 6)));
    nodes[SEGS] = { ...nodes[SEGS], px: nodes[SEGS].x + 2.4 };
    let last = performance.now();
    let calm = 0;
    let raf = 0;
    let grab: { dx: number; dy: number; px: number; py: number; t: number } | null = null;

    const f = (v: number) => v.toFixed(2);
    const render = () => {
      // smooth curve through the nodes: quadratic segments via midpoints
      let d = `M ${f(ax + nodes[0].x)} ${f(nodes[0].y)}`;
      for (let i = 1; i < SEGS; i++) {
        const mx = (nodes[i].x + nodes[i + 1].x) / 2, my = (nodes[i].y + nodes[i + 1].y) / 2;
        d += ` Q ${f(ax + nodes[i].x)} ${f(nodes[i].y)} ${f(ax + mx)} ${f(my)}`;
      }
      const c = nodes[SEGS], m = nodes[SEGS - 1];
      d += ` L ${f(ax + c.x)} ${f(c.y)}`;
      body.setAttribute('d', d); weave.setAttribute('d', d); stitch.setAttribute('d', d);
      const phi = Math.atan2(-(c.x - m.x), c.y - m.y); // hang along the last segment
      clip.setAttribute('transform', `translate(${f(ax + c.x)} ${f(c.y - 4)}) rotate(${f((phi * 180) / Math.PI)})`);
      card.style.transform = `translate(${f(ax + c.x)}px, ${f(c.y + 4)}px) translateX(-50%) rotate(${phi.toFixed(4)}rad)`;
    };

    const frame = (now: number) => {
      const dt = Math.min(MAX_DT, (now - last) / 1000);
      last = now;
      if (!grab) {
        for (let i = 0; i < SUB; i++) nodes = step(nodes, dt / SUB, seg);
        const c = nodes[SEGS];
        const speed = Math.hypot(c.x - c.px, c.y - c.py) / (dt / SUB);
        const settled = speed < 6 && Math.abs(c.x) < 0.3 && Math.abs(c.y - rest) < 0.5;
        calm = settled ? calm + 1 : 0;
      }
      render();
      if (calm > 40) { nodes = restPose(); render(); raf = 0; return; }
      raf = requestAnimationFrame(frame);
    };
    const wake = () => { if (!raf) { last = performance.now(); calm = 0; raf = requestAnimationFrame(frame); } };

    card.addEventListener('pointerdown', (e) => {
      const r = rig.getBoundingClientRect();
      const c = nodes[SEGS];
      grab = { dx: e.clientX - r.left - ax - c.x, dy: e.clientY - r.top - c.y, px: e.clientX, py: e.clientY, t: performance.now() };
      card.setPointerCapture(e.pointerId);
      wake();
    });
    card.addEventListener('pointermove', (e) => {
      if (!grab) return;
      const r = rig.getBoundingClientRect();
      const nx = e.clientX - r.left - ax - grab.dx, ny = e.clientY - r.top - grab.dy;
      // move the card to the pointer, keep its previous position for velocity, let the strap follow it
      const held = nodes.map((n, i) => (i === SEGS ? { x: nx, y: ny, px: n.x, py: n.y } : n));
      nodes = step(held, MAX_DT / SUB, seg).map((n, i) => (i === SEGS ? { ...n, x: nx, y: ny } : n));
      grab = { ...grab, px: e.clientX, py: e.clientY, t: performance.now() };
    });
    const release = () => { grab = null; wake(); };
    card.addEventListener('pointerup', release);
    card.addEventListener('pointercancel', release);

    wake();
  }
</script>
