---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
const en = t('en');
const zh = t('zh');
---
<BaseLayout title={`${en('notFound.title')} / ${zh('notFound.title')}`} description={en('notFound.body')} locale="en" path="/" noAlternates>
  <section class="wrap section center">
    <p class="eyebrow">404</p>
    <h1>{en('notFound.title')} / <span lang="zh-CN">{zh('notFound.title')}</span></h1>
    <p class="prose">{en('notFound.body')} <span lang="zh-CN">{zh('notFound.body')}</span></p>
    <p class="actions"><a class="btn btn-primary" href="/">{en('notFound.home')}</a> <a class="btn" href="/zh/" lang="zh-CN">{zh('notFound.home')}</a></p>
  </section>
</BaseLayout>
<style>
  .actions { margin-top: 2rem; display: flex; justify-content: center; gap: 0.6rem; flex-wrap: wrap; }
  h1 { margin: 1rem auto; }
</style>
