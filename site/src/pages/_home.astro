---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SpecRow from '../components/SpecRow.astro';
import WorkCard from '../components/WorkCard.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ProjectMini from '../components/ProjectMini.astro';
import Timeline from '../components/Timeline.astro';
import EducationCard from '../components/EducationCard.astro';
import Divider from '../components/Divider.astro';
import Life from '../components/Life.astro';
import Lightbox from '../components/Lightbox.astro';
import { t, type Locale } from '../i18n';
import { loadProfile } from '../lib/profile';
import { getProjects, slugOf } from '../lib/projects';
import Stack from '../components/Stack.astro';
import { buildStack } from '../lib/stack';
import type { GithubData } from '../lib/github';
import { fill, siteTokens } from '../lib/tokens';
import github from '../data/github.json';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const p = loadProfile(locale);
const allProjects = await getProjects(locale);
const projects = allProjects.filter((e) => e.data.featured);
// case pages already reachable from an analytics card or a mini card are not listed twice
const linkedSlugs = new Set([...p.analytics, ...p.miniProjects].map((item) => item.caseStudy));
const moreProjects = [
  ...allProjects.filter((e) => !e.data.featured && !linkedSlugs.has(slugOf(e))).map((e) => ({
    title: e.data.title,
    body: e.data.summary,
    period: e.data.period,
    caseStudy: slugOf(e),
    ...e.data.links,
    clientWork: false,
  })),
  ...p.miniProjects,
];
// the stack section reads the canonical (English) stack lists, so both locales show the same evidence
const stackGroups = buildStack((await getProjects('en')).map((e) => ({ slug: slugOf(e), stack: e.data.stack })), locale);
const tokens = siteTokens(github as GithubData, 'Guqin-AI', locale);
const stats = p.stats.map((s) =>
  s.source === 'tokens' ? { label: s.label, value: fill(s.value, tokens), hint: s.hint && fill(s.hint, tokens) } : { label: s.label, value: s.value, hint: s.hint },
);
---
<BaseLayout title={tr('site.title')} description={tr('site.description')} locale={locale} path="/">
  <Hero locale={locale} eyebrow={p.hero.eyebrow} title={p.hero.title} subtitle={p.hero.subtitle} email={p.contact.email} terminal={p.hero.terminal} />

  <section class="wrap section reveal" aria-label={tr('a11y.keyNumbers')}><SpecRow id="stats" items={stats} /></section>

  <Divider />
  <section id="work" class="wrap section">
    <div class="section-head reveal"><h2>{tr('sections.work')}</h2><p class="sub">{tr('sections.workSub')}</p></div>
    <div class:list={['grid-2', { 'single-project': projects.length === 1 }]}>{projects.map((e) => <WorkCard entry={e} locale={locale} wide={projects.length === 1} />)}</div>
  </section>

  <section id="analytics" class="wrap section">
    <div class="section-head reveal"><h2>{tr('sections.analytics')}</h2><p class="sub">{tr('sections.analyticsSub')}</p></div>
    <FeatureGrid items={p.analytics} locale={locale} />
  </section>

  <section id="more" class="wrap section">
    <div class="section-head reveal"><h2>{tr('sections.more')}</h2></div>
    <div class="grid-2 tight">{moreProjects.map((m) => <ProjectMini item={m} locale={locale} />)}</div>
  </section>

  <section id="stack" class="wrap section">
    <div class="section-head reveal"><h2>{tr('sections.stack')}</h2></div>
    <Stack groups={stackGroups} locale={locale} />
  </section>

  <Divider />
  <section id="experience" class="wrap section">
    <div class="section-head reveal"><h2>{tr('sections.experience')}</h2></div>
    <Timeline items={p.experience} />
  </section>

  <section id="education" class="wrap section">
    <div class="section-head reveal"><h2>{tr('sections.education')}</h2></div>
    <div class="grid-2">{p.education.map((e) => <EducationCard item={e} locale={locale} />)}</div>
  </section>

  <Divider />
  <Life locale={locale} />
  <Lightbox closeLabel={tr('case.close')} label={tr('a11y.imagePreview')} />
</BaseLayout>
<style>
  .single-project { grid-template-columns: 1fr; }
  .tight { gap: 1.25rem; }
</style>
