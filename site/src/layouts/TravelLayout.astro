---
// TravelLayout.astro — the photography & travel page: the world map of where the photos were taken (places.json,
// built by scripts/photo-places.mjs from the originals' EXIF) above one photo wall. All photos show by default;
// clicking a place on the map shows only that place's photos, clicking it again (or "show all") brings them back.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import TravelMap from '../components/figures/TravelMap.astro';
import { t, localePath, type Locale } from '../i18n';
import { loadLife } from '../lib/life';
import data from '../data/figures/places.json';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const life = loadLife(locale);
const hobby = life.hobbies.find((h) => h.id === 'photo');
if (!hobby?.page) throw new Error('life: the photo hobby has no page text');
const caption = new Map(life.photos.map((p) => [p.file, p.caption]));
const files = import.meta.glob<ImageMetadata>('../assets/life/**/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' });
const resolve = (file: string): ImageMetadata => {
  const meta = files[`../assets/life/${file}`];
  if (!meta) throw new Error(`travel: photo "${file}" not found under src/assets/life/`);
  return meta;
};
const places = [...data.places].sort((a, b) => (a.from ?? '9999').localeCompare(b.from ?? '9999'));
// newest first; the one undated photo goes last
const shots = await Promise.all(
  places.flatMap((p) => p.photos.map((ph) => ({ ...ph, place: p.id })))
    .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
    .map(async (ph) => { const meta = resolve(ph.file); return { ...ph, meta, large: await getImage({ src: meta, width: 1800, format: 'webp', quality: 80 }), caption: caption.get(ph.file) ?? '' }; }),
);
const nPhotos = places.reduce((n, p) => n + p.photos.length, 0);
const nCountries = new Set(places.map((p) => p.country[0])).size;
const nLibrary = places.reduce((n, p) => n + p.library, 0);
// every place, grouped by country (biggest country first), places by photo count
const byCountry = [...places.reduce((m, p) => m.set(p.country[0], [...(m.get(p.country[0]) ?? []), p]), new Map<string, typeof places>()).values()]
  .map((list) => list.sort((a, b) => b.library - a.library))
  .sort((a, b) => b.reduce((n, p) => n + p.library, 0) - a.reduce((n, p) => n + p.library, 0));
const mon = (m: string | null) => (m ? (locale === 'zh' ? `${m.slice(0, 4)} 年 ${Number(m.slice(5))} 月` : m) : '');
const span = (p: (typeof places)[number]) => (p.from && p.to && p.from !== p.to ? `${mon(p.from)} – ${mon(p.to)}` : mon(p.from));

---
<BaseLayout title={`${hobby.page.title} — ${tr('site.title')}`} description={hobby.page.intro} locale={locale} path="/life/photo/">
  <div class="wrap section page">
    <header class="head">
      <p class="eyebrow center fade-up" data-delay="1">{tr('sections.life')}</p>
      <h1 class="center fade-up" data-delay="2">{hobby.page.title}</h1>
      <p class="prose center fade-up" data-delay="3">{hobby.page.intro}</p>
      <p class="counts center fade-up" data-delay="4">{places.length} {tr('life.places')} · {nCountries} {tr('life.countries')} · {tr('life.libraryCount').replace('{n}', nLibrary.toLocaleString('en-US'))}</p>
    </header>
    <div class="map-wrap reveal"><TravelMap locale={locale} label={tr('life.map')} libraryWord={tr('life.libraryKey')} siteWord={tr('life.siteKey')} moreWord={tr('life.more')} /></div>
    <section class="where reveal" aria-label={tr('life.where')}>
      {byCountry.map((list) => (
        <div class="country">
          <h2>{list[0].country[locale === 'zh' ? 1 : 0]}<span>{list.length}</span></h2>
          <ul>
            {list.map((p) => (
              <li>
                {p.photos.length > 0
                  ? <button type="button" class="chip site" aria-pressed="false" data-filter data-places={p.id} data-title={locale === 'zh' ? p.zh : p.en} title={span(p)}><span>{locale === 'zh' ? p.zh : p.en}</span><b>{p.library.toLocaleString('en-US')}</b></button>
                  : <span class="chip" title={span(p)}><span>{locale === 'zh' ? p.zh : p.en}</span><b>{p.library.toLocaleString('en-US')}</b></span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
    <section class="wall" data-wall>
      <p class="filter" aria-live="polite">
        <span data-filter-label data-all={`${tr('life.all')} · ${nPhotos}`}>{tr('life.all')} · {nPhotos}</span>
        <button type="button" class="clear" data-clear hidden>{tr('life.showAll')}</button>
      </p>
      <ul class="shots">
        {shots.map((s, i) => (
          <li data-place={s.place}>
            <figure>
              <button type="button" data-lightbox-src={s.large.src} data-lightbox-alt={s.caption} aria-label={tr('a11y.openImage').replace('{n}', String(i + 1)).replace('{alt}', s.caption)}>
                <Image src={s.meta} alt={s.caption} width={640} format="webp" quality={80} loading="lazy" />
              </button>
              <figcaption>{s.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
    <p class="center back"><a class="btn" href={localePath('/#life', locale)}>← {tr('life.back')}</a></p>
  </div>
  <Lightbox closeLabel={tr('case.close')} label={tr('a11y.imagePreview')} />
</BaseLayout>
<script>
  const wall = document.querySelector<HTMLElement>('[data-wall]');
  if (wall) {
    const items = [...wall.querySelectorAll<HTMLElement>('.shots > li')];
    const label = wall.querySelector<HTMLElement>('[data-filter-label]')!;
    const clear = wall.querySelector<HTMLButtonElement>('[data-clear]')!;
    const apply = (ids: string[] | null, title = '') => {
      let shown = 0;
      for (const li of items) { const on = !ids || ids.includes(li.dataset.place ?? ''); li.hidden = !on; if (on) shown += 1; }
      label.textContent = ids ? `${title} · ${shown}` : (label.dataset.all ?? '');
      clear.hidden = !ids;
    };
    // map pins and place chips are both filters: [data-filter] with the place ids it stands for
    const filters = [...document.querySelectorAll<HTMLElement>('[data-filter]')];
    const press = (el: HTMLElement | null) => {
      const on = Boolean(el) && el!.getAttribute('aria-pressed') !== 'true';
      filters.forEach((f) => f.setAttribute('aria-pressed', 'false'));
      if (on) {
        const ids = (el!.dataset.places ?? '').split(' ');
        // press every filter showing exactly these places (a pin and its chip light up together)
        filters.filter((f) => f.dataset.places === el!.dataset.places).forEach((f) => f.setAttribute('aria-pressed', 'true'));
        apply(ids, el!.dataset.title ?? '');
        wall.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      } else apply(null);
    };
    for (const f of filters) {
      f.addEventListener('click', () => press(f));
      if (f.tagName.toLowerCase() === 'g') f.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); press(f); } });
    }
    clear.addEventListener('click', () => press(null));
  }
</script>
<style>
  .head { max-width: var(--measure); margin: 0 auto 2rem; }
  .head h1 { margin: 0.4rem 0 1rem; }
  .counts { margin-top: 0.8rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--fg-muted); }
  .map-wrap { margin: 0 0 1.6rem; }
  .where { display: grid; gap: 1rem 2rem; grid-template-columns: 1fr; margin: 0 0 3.5rem; }
  @media (min-width: 720px) { .where { grid-template-columns: 2fr 1fr; } }
  .country h2 { display: flex; align-items: baseline; gap: 0.5rem; margin: 0 0 0.5rem; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-muted); }
  .country ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip { all: unset; display: inline-flex; align-items: baseline; gap: 0.45rem; padding: 0.25rem 0.65rem; border: 1px solid var(--rule); border-radius: 999px; font-size: 0.82rem; color: var(--fg); }
  .chip b { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 400; color: var(--fg-muted); }
  .chip.site { cursor: pointer; border-color: color-mix(in srgb, var(--accent) 45%, var(--bg)); }
  .chip.site::before { content: ''; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--accent); align-self: center; }
  .chip.site:hover { background: var(--card); }
  .chip.site:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .chip[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .chip[aria-pressed='true'] b { color: var(--bg); }
  .chip[aria-pressed='true']::before { background: var(--bg); }
  .wall { margin-bottom: 3rem; scroll-margin-top: calc(var(--header-h) + 1rem); }
  .filter { display: flex; align-items: baseline; gap: 0.9rem; margin: 0 0 1.1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--rule); font-family: var(--font-sans); font-size: 1.05rem; font-weight: 600; }
  .clear { all: unset; cursor: pointer; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 400; color: var(--fg-muted); }
  .clear[hidden] { display: none; }
  .clear:hover { color: var(--fg); }
  .clear:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  .shots li[hidden] { display: none; }
  .shots { list-style: none; margin: 0; padding: 0; columns: 1; column-gap: 1.1rem; }
  @media (min-width: 560px) { .shots { columns: 2; } }
  @media (min-width: 900px) { .shots { columns: 3; } }
  .shots li { break-inside: avoid; margin-bottom: 1.1rem; }
  figure { margin: 0; }
  .shots button { all: unset; display: block; width: 100%; cursor: zoom-in; border-radius: 10px; overflow: hidden; background: var(--card); }
  .shots button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .shots img { display: block; width: 100%; height: auto; }
  figcaption { font-size: 0.8rem; color: var(--fg-muted); margin-top: 0.45rem; line-height: 1.45; }
  .back { margin-top: 1rem; }
</style>
